# CodeVitals Configuration
CODEVITALS_URL=https://www.codevitals.run
CODEVITALS_TOKEN=your_token_here

# WordPress Configuration
WP_ADMIN_USER=admin
WP_ADMIN_PASS=password
WP_ADMIN_EMAIL=admin@example.com

# WordPress URLs (Docker defaults)
WP_BASELINE_URL=http://localhost:8080
WP_JETPACK_URL=http://localhost:8081
WP_JETPACK_OFFLINE_URL=http://localhost:8082
WP_JETPACK_CONNECTED_URL=http://localhost:8083

# Simulated WP.com API latency (milliseconds) for connected scenario
WPCOM_SIMULATED_LATENCY_MS=200

# Test Configuration
ITERATIONS=5
# Timeout for MySQL readiness check during setup (seconds)
# MYSQL_READY_TIMEOUT_SECONDS=120
# Timeout for WordPress readiness check during setup (seconds)
# WP_READY_TIMEOUT_SECONDS=60

# Git Information (auto-detected if not set)
# GIT_COMMIT=
# GIT_BRANCH=

# Output Configuration
OUTPUT_PATH=./results/lcp-results.json

# Jetpack plugin path (relative to docker/ directory)
# JETPACK_PLUGIN_PATH=../../../projects/plugins/jetpack
