#!/usr/bin/env bash

# Enable debug mode if DEBUG environment variable is set
if [ "${DEBUG:-}" = "1" ]; then
    set -x
fi

# Get the absolute path to the monorepo root
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
MONOREPO_ROOT="$( cd "$SCRIPT_DIR/../../.." && pwd )"

echo "Running command in monorepo container: $*"

# Source the versions file
source "$MONOREPO_ROOT/.github/versions.sh"

# Export variables needed by docker-compose
export HOST_CWD="$MONOREPO_ROOT"

# Check if we should pull the latest image
CACHE_FILE="$MONOREPO_ROOT/tools/docker/data/.monorepo-image-check"
SHOULD_PULL=0

# Always pull if image doesn't exist
if ! docker image inspect jetpack-monorepo:latest >/dev/null 2>&1; then
    SHOULD_PULL=1
# Force pull if FORCE_PULL environment variable is set
elif [[ "${FORCE_PULL:-}" = "1" ]]; then
    SHOULD_PULL=1
    echo "Forcing image update due to FORCE_PULL environment variable..."
# Pull if cache file doesn't exist or is older than 24 hours (86400 seconds)
elif [[ ! -f "$CACHE_FILE" ]]; then
    SHOULD_PULL=1
else
    # Check if file is older than 24 hours
    if [[ "$(uname)" = "Darwin" ]]; then
        # macOS date command
        FILE_TIME=$(stat -f %m "$CACHE_FILE" 2>/dev/null || echo 0)
    else
        # Linux date command
        FILE_TIME=$(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0)
    fi
    CURRENT_TIME=$(date +%s)
    TIME_DIFF=$((CURRENT_TIME - FILE_TIME))

    if [[ "$TIME_DIFF" -gt 86400 ]]; then
        SHOULD_PULL=1
    fi
fi

# Pull or build the image if needed
if [[ "$SHOULD_PULL" = "1" ]]; then
    if [[ "${BUILD_LOCAL:-}" = "1" ]]; then
        echo "Building monorepo image locally..."
        docker build \
            --build-arg PHP_VERSION="$PHP_VERSION" \
            --build-arg COMPOSER_VERSION="$COMPOSER_VERSION" \
            --build-arg NODE_VERSION="$NODE_VERSION" \
            --build-arg PNPM_VERSION="$PNPM_VERSION" \
            -t jetpack-monorepo:latest \
            -f "$MONOREPO_ROOT/tools/docker/Dockerfile.monorepo" \
            "$MONOREPO_ROOT/tools/docker"
    else
        echo "Checking for latest monorepo image..."
        docker pull automattic/jetpack-monorepo:latest
        docker tag automattic/jetpack-monorepo:latest jetpack-monorepo:latest
    fi

    # Update the timestamp file
    mkdir -p "$(dirname "$CACHE_FILE")"
    touch "$CACHE_FILE"
fi

# Check if pnpm store location has changed and needs migration
# This handles the case where PNPM_STORE_DIR was updated to fix hard link issues
EXPECTED_STORE_DIR="/workspace/tools/docker/data/pnpm-store"
MODULES_YAML="$MONOREPO_ROOT/node_modules/.modules.yaml"

if [[ -f "$MODULES_YAML" ]]; then
    # Extract storeDir from .modules.yaml (format: "storeDir: /path/to/store/v10")
    CURRENT_STORE_DIR=$(grep "^storeDir:" "$MODULES_YAML" | sed 's/^storeDir: *//' | sed 's|/v[0-9]*$||')

    if [[ -n "$CURRENT_STORE_DIR" && "$CURRENT_STORE_DIR" != "$EXPECTED_STORE_DIR" ]]; then
        echo "Detected pnpm store location change:"
        echo "  Old: $CURRENT_STORE_DIR"
        echo "  New: $EXPECTED_STORE_DIR"
        echo "Cleaning up for fresh install with new store location..."
        echo "This will delete and reinstall node_modules..."
        echo "Yes, it'll take a bit. It should be a one-time operation."

        # Delete node_modules
        if rm -rf "$MONOREPO_ROOT/node_modules"; then
            echo "  Removed node_modules/"
        fi

        # Delete old store in background (if it exists within the workspace)
        OLD_STORE_HOST_PATH="${CURRENT_STORE_DIR/#\/workspace/$MONOREPO_ROOT}"
        if [[ -d "$OLD_STORE_HOST_PATH" ]]; then
            rm -rf "$OLD_STORE_HOST_PATH" &
            OLD_STORE_RM_PID=$!
            echo "  Removing old store in background: $OLD_STORE_HOST_PATH"
        fi

        # Install root workspace only (for git hooks) - runs in parallel with old store deletion
        docker run --rm \
            -v "$MONOREPO_ROOT:/workspace" \
            -w /workspace \
            -e npm_config_store_dir=/workspace/tools/docker/data/pnpm-store \
            jetpack-monorepo:latest \
            pnpm install --filter .

        # Wait for background old store removal to finish
        if [[ -n "${OLD_STORE_RM_PID:-}" ]]; then
            echo "New store primed. Waiting for old store deletion to complete..."
            wait $OLD_STORE_RM_PID
            echo "  Old store cleanup complete."
        fi

        echo "Migration complete. Now using the new store location."
    fi
fi

# Run the command in the container
# Use -it only if we have a TTY available
# If stdin was redirected (e.g., by git hooks) but /dev/tty is available, reconnect to it
  if [[ ! -t 0 && -c /dev/tty ]] && sh -c ': < /dev/tty' >/dev/null 2>/dev/null; then
      exec < /dev/tty
  fi

  if [[ -t 0 ]]; then
      TTY_FLAG="-it"
  else
      TTY_FLAG=""
  fi

  # Get git user config from host to use for commits inside container
  GIT_USER_NAME=$(git config user.name 2>/dev/null || echo "")
  GIT_USER_EMAIL=$(git config user.email 2>/dev/null || echo "")

  docker run --rm $TTY_FLAG \
    -v "$MONOREPO_ROOT:/workspace" \
    -v "$MONOREPO_ROOT/tools/docker/data/monorepo:/root" \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -w /workspace \
    -e TERM=$TERM \
    -e COLORTERM=$COLORTERM \
    -e JETPACK_MONOREPO_ENV=1 \
    -e HUSKY=0 \
    -e CI="${CI:-}" \
    -e DOCKER_ROOT="$MONOREPO_ROOT/tools/docker" \
    -e HOST_CWD="$MONOREPO_ROOT" \
    -e WORKSPACE_PATH="$MONOREPO_ROOT" \
    -e NPM_CONFIG_USERCONFIG=/root/.npmrc \
    -e NPM_CONFIG_CACHE=/root/.npm \
    -e PNPM_HOME=/root/.local/share/pnpm \
    -e npm_config_store_dir=/workspace/tools/docker/data/pnpm-store \
    -e GIT_AUTHOR_NAME="${GIT_USER_NAME}" \
    -e GIT_AUTHOR_EMAIL="${GIT_USER_EMAIL}" \
    -e GIT_COMMITTER_NAME="${GIT_USER_NAME}" \
    -e GIT_COMMITTER_EMAIL="${GIT_USER_EMAIL}" \
    jetpack-monorepo:latest \
    "$@"
