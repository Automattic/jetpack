		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.13.3",
		"@wordpress/base-styles": "^13.1.0",
		"@wordpress/jest-console": "^9.3.0",
		"fast-glob": "^3.2.7",
		"storybook": "^10.5.3",
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"@types/react": "^18 || ^19",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		}
