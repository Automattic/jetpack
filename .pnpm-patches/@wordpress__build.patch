diff --git a/lib/shared-modules-manifest.mjs b/lib/shared-modules-manifest.mjs
new file mode 100644
index 0000000..97cf4dd
--- /dev/null
+++ b/lib/shared-modules-manifest.mjs
@@ -0,0 +1,83 @@
+import { readFile } from 'fs/promises';
+import path from 'path';
+
+/**
+ * Read a provider's `wpSharedModules` config and the export list it is pruned to.
+ *
+ * @param {string} packageJsonPath Path to the providing package's package.json.
+ * @return {Promise<Object>} The config and its directory, the module ID per bare specifier (`modules`), the module
+ *   name per ID (`names`), the stylesheets the modules inject, and the exported names per module name, if listed.
+ */
+export async function readSharedModulesManifest( packageJsonPath ) {
+	const dir = path.dirname( packageJsonPath );
+	const config = JSON.parse( await readFile( packageJsonPath, 'utf8' ) )
+		.wpSharedModules;
+	const ids = Object.fromEntries(
+		Object.entries( config.modules ).map( ( [ specifier, name ] ) => [
+			specifier,
+			`@${ config.namespace }/${ name }`,
+		] )
+	);
+	const exportsPath = config.exports
+		? path.resolve( dir, config.exports )
+		: null;
+	return {
+		config,
+		dir,
+		modules: ids,
+		names: Object.fromEntries(
+			Object.entries( config.modules ).map( ( [ specifier, name ] ) => [
+				ids[ specifier ],
+				name,
+			] )
+		),
+		styles: Object.values( config.styles ?? {} )
+			.flat()
+			.map( ( style ) => style.replace( /\.css$/, '' ) ),
+		exports: exportsPath
+			? JSON.parse( await readFile( exportsPath, 'utf8' ) )
+			: null,
+		exportsPath,
+	};
+}
+
+/**
+ * List the names a built ES module imports from each of the given module IDs.
+ *
+ * Parses esbuild's output, not arbitrary source: `*` stands for a namespace or dynamic import.
+ *
+ * @param {string}      source Built module source.
+ * @param {Set<string>} ids    Module IDs to look for.
+ * @return {Map<string, Set<string>>} Imported names per module ID.
+ */
+export function findSharedImports( source, ids ) {
+	const used = new Map();
+	const add = ( id, name ) => {
+		if ( ids.has( id ) ) {
+			( used.get( id ) ?? used.set( id, new Set() ).get( id ) ).add( name );
+		}
+	};
+	for ( const [ , clause, id ] of source.matchAll(
+		/import\s*([^"';]*?)\s*from\s*["']([^"']+)["']/g
+	) ) {
+		if ( /^\*/.test( clause ) ) {
+			add( id, '*' );
+		}
+		if ( /^[\w$]+/.test( clause ) ) {
+			add( id, 'default' );
+		}
+		for ( const part of clause.match( /\{([^}]*)\}/ )?.[ 1 ].split( ',' ) ??
+			[] ) {
+			const name = part.trim().split( /\s+as\s+/ )[ 0 ];
+			if ( name ) {
+				add( id, name );
+			}
+		}
+	}
+	for ( const [ , id ] of source.matchAll(
+		/import\(\s*["']([^"']+)["']\s*\)/g
+	) ) {
+		add( id, '*' );
+	}
+	return used;
+}
