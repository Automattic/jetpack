index 0000000..cebf754
--- /dev/null
+++ b/lib/shared-modules-manifest.mjs
@@ -0,0 +1,113 @@
+import { readFile } from 'fs/promises';
+import path from 'path';
+
+/**
+ * Read a provider's `wpSharedModules` config and the export list its modules are pruned to.
+ *
+ * @param {string} packageJsonPath Path to the providing package's package.json.
+ * @return {Promise<Object>} The config and its directory, the module ID per bare specifier (`modules`), the module
+ *   name per ID (`names`), the stylesheets the modules inject, and the exported names per module name.
+ */
+export async function readSharedModulesManifest( packageJsonPath ) {
+	const dir = path.dirname( packageJsonPath );
+	const config = JSON.parse( await readFile( packageJsonPath, 'utf8' ) )
+		.wpSharedModules;
+	if ( ! config?.exports ) {
+		throw new Error(
+			`${ packageJsonPath } needs \`wpSharedModules.exports\`, the export list file.`
+		);
+	}
+	const modules = {};
+	const names = {};
+	for ( const [ specifier, name ] of Object.entries( config.modules ) ) {
+		modules[ specifier ] = `@${ config.namespace }/${ name }`;
+		names[ modules[ specifier ] ] = name;
+	}
+	const exportsPath = path.resolve( dir, config.exports );
+	let exports = {};
+	try {
+		exports = JSON.parse( await readFile( exportsPath, 'utf8' ) );
+	} catch ( error ) {
+		// `--update-exports` creates the file; until then, every import fails the check.
+		if ( error.code !== 'ENOENT' ) {
+			throw error;
+		}
+	}
+	return {
+		config,
+		dir,
+		modules,
+		names,
+		styles: Object.values( config.styles ?? {} ).flat(),
+		exports,
+		exportsPath,
+	};
+}
+
+/**
+ * Create a Sass importer that loads the given stylesheets as empty files.
+ *
+ * @param {string[]} styles Stylesheet URLs, as `@use` or `meta.load-css()` name them.
+ * @return {import('sass-embedded').Importer<'async'>} Sass importer.
+ */
+export function createSharedStylesImporter( styles ) {
+	const urls = new Set( styles.map( ( url ) => url.replace( /\.css$/, '' ) ) );
+	return {
+		canonicalize( url ) {
+			const name = url.replace( /\.css$/, '' );
+			return urls.has( name )
+				? new URL( `wp-build-shared-style:${ name }` )
+				: null;
+		},
+		load() {
+			return { contents: '', syntax: 'css' };
+		},
+	};
+}
+
+/**
+ * List the names a built ES module imports or re-exports from each of the given module IDs.
+ *
+ * Parses Rolldown's output, not arbitrary source: `*` stands for a namespace, `export *` or dynamic import.
+ *
+ * @param {string}      source Built module source.
+ * @param {Set<string>} ids    Module IDs to look for.
+ * @return {Map<string, Set<string>>} Imported names per module ID, empty for a bare `import "id"`.
+ */
+export function findSharedImports( source, ids ) {
+	const used = new Map();
+	const add = ( id, name ) => {
+		if ( ids.has( id ) ) {
+			const names = used.get( id ) ?? used.set( id, new Set() ).get( id );
+			if ( name ) {
+				names.add( name );
+			}
+		}
+	};
+	for ( const [ , keyword, clause, id ] of source.matchAll(
+		/\b(import|export)\s*([^"';]*?)\s*from\s*["']([^"']+)["']/g
+	) ) {
+		if ( /(^|,)\s*\*/.test( clause ) ) {
+			add( id, '*' );
+		}
+		if ( keyword === 'import' && /^[\w$]+/.test( clause ) ) {
+			add( id, 'default' );
+		}
+		for ( const part of clause.match( /\{([^}]*)\}/ )?.[ 1 ].split( ',' ) ??
+			[] ) {
+			const name = part.trim().split( /\s+as\s+/ )[ 0 ];
+			if ( name ) {
+				add( id, name );
+			}
+		}
+	}
+	for ( const [ , id ] of source.matchAll( /\bimport\s*["']([^"']+)["']/g ) ) {
+		add( id );
+	}
+	for ( const [ , id ] of source.matchAll(
+		/\bimport\(\s*["']([^"']+)["']\s*\)/g
+	) ) {
+		add( id, '*' );
+	}
+	return used;
+}
