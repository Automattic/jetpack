+#!/usr/bin/env node
+/**
+ * Bundles libraries that several wp-build plugins use into shared script modules.
+ *
+ * Reads `wpSharedModules` from the project's package.json:
+ * { namespace, outdir, modules: { specifier: name }, styles: { name: [ stylesheet ] }, consumers: [ glob ] }
+ * and writes `<outdir>/manifest.json` for `wpPlugin.sharedModules` plus `<outdir>/modules.php`.
+ */
+import { mkdir, readFile, rm, writeFile } from 'fs/promises';
+import path from 'path';
+import { createHash } from 'crypto';
+import { createRequire } from 'node:module';
+import esbuild from 'esbuild';
+import glob from 'fast-glob';
+import browserslistToEsbuild from 'browserslist-to-esbuild';
+import { sassPlugin } from 'esbuild-sass-plugin';
+import { NodePackageImporter } from 'sass-embedded';
+import { getBrowserslistQueries } from './browserslist.mjs';
+import { compileInlineStyle } from './compile-inline-style.mjs';
+import { createWordpressExternalsPlugin } from './wordpress-externals-plugin.mjs';
+
+const ROOT_DIR = process.cwd();
+const config = JSON.parse(
+	await readFile( path.join( ROOT_DIR, 'package.json' ), 'utf8' )
+).wpSharedModules;
+const outdir = path.join( ROOT_DIR, config.outdir );
+const styleRuntimeEntry = path.join(
+	path.dirname(
+		createRequire( import.meta.url ).resolve(
+			'@wordpress/style-runtime/package.json'
+		)
+	),
+	'src/index.ts'
+);
+
+const sassOptions = {
+	importers: [ new NodePackageImporter( ROOT_DIR ) ],
+	loadPaths: [ path.join( ROOT_DIR, 'node_modules' ) ],
+};
+const stylePlugins = [
+	{
+		name: 'style-runtime-alias',
+		setup( build ) {
+			build.onResolve( { filter: /^@wordpress\/style-runtime$/ }, () => ( {
+				path: styleRuntimeEntry,
+			} ) );
+		},
+	},
+	sassPlugin( {
+		embedded: true,
+		filter: /\.module\.(css|scss)$/,
+		transform: compileInlineStyle( { cssModules: true } ),
+		type: ( contents ) => contents,
+		...sassOptions,
+	} ),
+	sassPlugin( {
+		embedded: true,
+		filter: /\.(css|scss)$/,
+		transform: compileInlineStyle(),
+		type: ( contents ) => contents,
+		...sassOptions,
+	} ),
+];
+
+// `export *` skips a default export, so re-export it only where the library has one.
+async function hasDefaultExport( specifier ) {
+	let file;
+	await esbuild.build( {
+		stdin: { contents: '', resolveDir: ROOT_DIR },
+		write: false,
+		logLevel: 'silent',
+		plugins: [
+			{
+				name: 'resolve-only',
+				setup( build ) {
+					build.onStart( async () => {
+						file = (
+							await build.resolve( specifier, {
+								kind: 'import-statement',
+								resolveDir: ROOT_DIR,
+							} )
+						).path;
+					} );
+				},
+			},
+		],
+	} );
+	const result = await esbuild.build( {
+		entryPoints: [ file ],
+		bundle: false,
+		write: false,
+		metafile: true,
+		format: 'esm',
+		logLevel: 'silent',
+	} );
+	return Object.values( result.metafile.outputs ).some( ( output ) =>
+		output.exports.includes( 'default' )
+	);
+}
+
+/*
+ * Once the consumers are built, export only the names they import so the shared bundle (and the
+ * CSS it injects) can be tree-shaken. Consumers must be rebuilt first when they import new names.
+ */
+async function findUsedExports() {
+	const files = await glob( config.consumers ?? [], { cwd: ROOT_DIR, absolute: true } );
+	if ( ! files.length ) {
+		return null;
+	}
+	const used = {};
+	for ( const file of files ) {
+		const source = await readFile( file, 'utf8' );
+		for ( const [ , clause, id ] of source.matchAll(
+			/import\s*([^"';]*?)\s*from\s*["']([^"']+)["']/g
+		) ) {
+			const names = ( used[ id ] ??= new Set() );
+			if ( /^\*/.test( clause ) ) {
+				names.add( '*' );
+			}
+			if ( /^[\w$]+/.test( clause ) ) {
+				names.add( 'default' );
+			}
+			for ( const part of clause.match( /\{([^}]*)\}/ )?.[ 1 ].split( ',' ) ?? [] ) {
+				const name = part.trim().split( /\s+as\s+/ )[ 0 ];
+				if ( name ) {
+					names.add( name );
+				}
+			}
+		}
+		for ( const [ , id ] of source.matchAll( /import\(\s*["']([^"']+)["']\s*\)/g ) ) {
+			( used[ id ] ??= new Set() ).add( '*' );
+		}
+	}
+	return used;
+}
+const usedExports = await findUsedExports();
+
+const entries = {};
+for ( const [ specifier, name ] of Object.entries( config.modules ) ) {
+	const used = usedExports?.[ `@${ config.namespace }/${ name }` ] ?? new Set( [ '*' ] );
+	const named = [ ...used ].filter( ( n ) => n !== '*' && n !== 'default' );
+	const lines = used.has( '*' )
+		? [ `export * from ${ JSON.stringify( specifier ) };` ]
+		: [ `export { ${ named.join( ', ' ) } } from ${ JSON.stringify( specifier ) };` ];
+	if ( ( used.has( '*' ) || used.has( 'default' ) ) && ( await hasDefaultExport( specifier ) ) ) {
+		lines.push( `export { default } from ${ JSON.stringify( specifier ) };` );
+	}
+	for ( const style of config.styles?.[ name ] ?? [] ) {
+		lines.push( `import ${ JSON.stringify( style ) };` );
+	}
+	entries[ name ] = lines.join( '\n' );
+}
+
+await rm( outdir, { recursive: true, force: true } );
+await mkdir( outdir, { recursive: true } );
+// The externals plugin hashes the file its asset is named after.
+await writeFile( path.join( outdir, 'shared.min.js' ), '' );
+
+const result = await esbuild.build( {
+	entryPoints: Object.keys( entries ).map( ( name ) => ( {
+		in: `shared-entry:${ name }`,
+		out: `${ name }.min`,
+	} ) ),
+	outdir,
+	bundle: true,
+	splitting: true,
+	format: 'esm',
+	minify: true,
+	charset: 'utf8',
+	metafile: true,
+	target: browserslistToEsbuild( getBrowserslistQueries() ),
+	platform: 'browser',
+	chunkNames: 'chunk-[hash]',
+	define: {
+		'process.env.NODE_ENV': '"production"',
+		'process.env.IS_GUTENBERG_PLUGIN': 'false',
+		'process.env.IS_WORDPRESS_CORE': 'false',
+		'globalThis.IS_GUTENBERG_PLUGIN': 'false',
+		'globalThis.IS_WORDPRESS_CORE': 'false',
+		'globalThis.SCRIPT_DEBUG': 'false',
+	},
+	plugins: [
+		{
+			name: 'shared-entries',
+			setup( build ) {
+				build.onResolve( { filter: /^shared-entry:/ }, ( args ) => ( {
+					path: args.path.slice( 'shared-entry:'.length ),
+					namespace: 'shared-entry',
+				} ) );
+				build.onLoad( { filter: /.*/, namespace: 'shared-entry' }, ( args ) => ( {
+					contents: entries[ args.path ],
+					resolveDir: ROOT_DIR,
+					loader: 'js',
+				} ) );
+			},
+		},
+		...stylePlugins,
+		createWordpressExternalsPlugin( 'wordpress', 'wp' )( 'shared.min', 'esm' ),
+	],
+} );
+await rm( path.join( outdir, 'shared.min.js' ) );
+
+const hash = createHash( 'sha256' );
+for ( const file of Object.keys( result.metafile.outputs ).sort() ) {
+	hash.update( await readFile( path.join( ROOT_DIR, file ) ) );
+}
+const version = hash.digest( 'hex' ).slice( 0, 20 );
+
+const ids = Object.fromEntries(
+	Object.entries( config.modules ).map( ( [ specifier, name ] ) => [
+		specifier,
+		`@${ config.namespace }/${ name }`,
+	] )
+);
+await writeFile(
+	path.join( outdir, 'manifest.json' ),
+	JSON.stringify(
+		{
+			modules: ids,
+			styles: Object.values( config.styles ?? {} )
+				.flat()
+				.map( ( style ) => style.replace( /\.css$/, '' ) ),
+		},
+		null,
+		'\t'
+	) + '\n'
+);
+const phpModules = Object.entries( config.modules )
+	.map(
+		( [ specifier, name ] ) =>
+			`'${ ids[ specifier ] }' => '${ name }.min.js'`
+	)
+	.join( ', ' );
+await writeFile(
+	path.join( outdir, 'modules.php' ),
+	`<?php return array( 'modules' => array( ${ phpModules } ), 'version' => '${ version }' );\n`
+);
+
+for ( const [ file, output ] of Object.entries( result.metafile.outputs ) ) {
+	console.log( `   ${ path.relative( ROOT_DIR, file ) } ${ ( output.bytes / 1024 ) | 0 }K` );
+}
