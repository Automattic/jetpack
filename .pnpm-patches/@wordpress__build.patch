+/**
+ * Remove loads of stylesheets that a shared script module already injects once for every plugin.
+ *
+ * @param {string} source Sass source.
+ * @return {string} Sass source without those loads.
+ */
+function dropSharedStyles( source ) {
+	if ( ! SHARED_MODULES.styles.length ) {
+		return source;
+	}
+	const urls = SHARED_MODULES.styles
+		.map( ( url ) => url.replace( /[.*+?^${}()|[\]\\]/g, '\\$&' ) )
+		.join( '|' );
+	return source.replace(
+		new RegExp(
+			`^\\s*@(?:include\\s+meta\\.load-css\\(|use\\s+)\\s*["'](?:${ urls })(?:\\.css)?["'][^;]*;`,
+			'gm'
+		),
+		''
+	);
+}
+
