# ShellCheck configuration for the Jetpack monorepo.
# Docs: https://github.com/koalaman/shellcheck/wiki/Directive#shellcheckrc-file

# Read referenced files, which helps avoid SC1090 (can't follow non-constant source) and SC2154 (var referenced but not assigned).
external-sources=true
# Resolve from script dir, not cwd.
source-path=SCRIPTDIR

# SC1087: Use braces when expanding arrays. https://www.shellcheck.net/wiki/SC1087
disable=SC1087
# SC1090: ShellCheck can't follow non-constant source. https://www.shellcheck.net/wiki/SC1090
disable=SC1090
# SC2034: Variable appears unused. https://www.shellcheck.net/wiki/SC2034
disable=SC2034
# SC2043: This loop will only ever run once. https://www.shellcheck.net/wiki/SC2043
disable=SC2043
# SC2089: Quotes/backslashes will be treated literally. https://www.shellcheck.net/wiki/SC2089
disable=SC2089
# SC2090: Quotes/backslashes in this variable will not be respected. https://www.shellcheck.net/wiki/SC2090
disable=SC2090
# SC2091: Remove surrounding $() to avoid executing output. https://www.shellcheck.net/wiki/SC2091
disable=SC2091
# SC2104: In functions, use return instead of break/continue. https://www.shellcheck.net/wiki/SC2104
disable=SC2104
# SC2120: Function references arguments, but none are ever passed. https://www.shellcheck.net/wiki/SC2120
disable=SC2120
# SC2128: Expanding an array without an index only gives the first element. https://www.shellcheck.net/wiki/SC2128
disable=SC2128
