{
	"name": "@automattic/charts",
	"version": "1.0.1",
	"description": "Display charts within Automattic products.",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/js-packages/charts/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[JS Package] Charts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/charts.git"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"type": "module",
	"exports": {
		".": {
			"jetpack:src": "./src/index.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./style.css": "./dist/index.css",
		"./visx/group": {
			"jetpack:src": "./src/visx/group/index.ts",
			"import": "./dist/visx/group/index.js",
			"require": "./dist/visx/group/index.cjs"
		},
		"./visx/legend": {
			"jetpack:src": "./src/visx/legend/index.ts",
			"import": "./dist/visx/legend/index.js",
			"require": "./dist/visx/legend/index.cjs"
		},
		"./visx/text": {
			"jetpack:src": "./src/visx/text/index.ts",
			"import": "./dist/visx/text/index.js",
			"require": "./dist/visx/text/index.cjs"
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"typesVersions": {
		"*": {
			".": [
				"./dist/index.d.ts"
			],
			"visx/group": [
				"./dist/visx/group/index.d.ts"
			],
			"visx/legend": [
				"./dist/visx/legend/index.d.ts"
			],
			"visx/text": [
				"./dist/visx/text/index.d.ts"
			]
		}
	},
	"scripts": {
		"build": "pnpm run build:prod",
		"build:prod": "tsup",
		"storybook": "cd ../storybook && pnpm run storybook:dev",
		"test": "TZ=UTC jest --config=tests/jest.config.cjs",
		"test-coverage": "pnpm run test --coverage",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@automattic/number-formatters": "workspace:*",
		"@babel/runtime": "7.28.6",
		"@react-spring/web": "9.7.5",
		"@visx/annotation": "^3.12.0",
		"@visx/axis": "^3.12.0",
		"@visx/curve": "^3.12.0",
		"@visx/event": "^3.12.0",
		"@visx/gradient": "^3.12.0",
		"@visx/grid": "^3.12.0",
		"@visx/group": "^3.12.0",
		"@visx/legend": "^3.12.0",
		"@visx/pattern": "^3.12.0",
		"@visx/responsive": "^3.12.0",
		"@visx/scale": "^3.12.0",
		"@visx/shape": "^3.12.0",
		"@visx/text": "^3.12.0",
		"@visx/tooltip": "^3.12.0",
		"@visx/vendor": "^3.12.0",
		"@visx/xychart": "^3.12.0",
		"@wordpress/i18n": "^6.0.0",
		"@wordpress/theme": "0.10.0",
		"@wordpress/ui": "0.9.0",
		"clsx": "2.1.1",
		"date-fns": "^4.1.0",
		"deepmerge": "4.3.1",
		"dompurify": "^3.3.3",
		"fast-deep-equal": "3.1.3",
		"gridicons": "3.4.2",
		"react-google-charts": "^5.2.1",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@babel/core": "7.29.0",
		"@babel/preset-react": "7.28.5",
		"@babel/preset-typescript": "7.28.5",
		"@storybook/addon-docs": "10.3.3",
		"@storybook/react": "10.3.3",
		"@testing-library/dom": "^10.0.0",
		"@testing-library/jest-dom": "^6.0.0",
		"@testing-library/react": "^16.0.0",
		"@testing-library/user-event": "^14.4.3",
		"@types/jest": "^30.0.0",
		"@types/react": "18.3.28",
		"@types/react-dom": "18.3.7",
		"@typescript/native-preview": "7.0.0-dev.20260225.1",
		"@visx/glyph": "3.12.0",
		"@wordpress/components": "32.5.0",
		"@wordpress/element": "6.43.0",
		"babel-jest": "30.3.0",
		"babel-plugin-react-remove-properties": "^0.3.1",
		"esbuild": "0.27.4",
		"esbuild-plugin-babel": "^0.2.3",
		"esbuild-sass-plugin": "^3.1.0",
		"identity-obj-proxy": "^3.0.0",
		"jest": "30.3.0",
		"jest-extended": "7.0.0",
		"postcss": "8.5.6",
		"postcss-modules": "6.0.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"sass-embedded": "1.97.3",
		"storybook": "10.3.3",
		"tsup": "8.5.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"react": "^17.0.0 || ^18.0.0",
		"react-dom": "^17.0.0 || ^18.0.0"
	},
	"engines": {
		"node": ">=20.11.0"
	}
}
