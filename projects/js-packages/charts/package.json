{
	"name": "@automattic/charts",
	"version": "0.32.0",
	"description": "Display charts within Automattic products.",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/js-packages/charts/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[JS Package] Charts"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/js-packages/charts"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"exports": {
		".": {
			"jetpack:src": "./src/index.ts",
			"import": "./dist/mjs/index.js",
			"require": "./dist/cjs/index.js",
			"types": "./dist/types/index.d.ts"
		},
		"./*": {
			"jetpack:src": "./src/components/*",
			"import": "./dist/mjs/components/*/index.js",
			"require": "./dist/cjs/components/*/index.js",
			"types": "./dist/types/components/*/index.d.ts"
		},
		"./providers/*": {
			"jetpack:src": "./src/providers/*",
			"import": "./dist/mjs/providers/*/index.js",
			"require": "./dist/cjs/providers/*/index.js",
			"types": "./dist/types/providers/*/index.d.ts"
		},
		"./style.css": "./dist/mjs/style.css",
		"./visx/*": {
			"jetpack:src": "./src/visx/*",
			"import": "./dist/mjs/visx/*/index.js",
			"require": "./dist/cjs/visx/*/index.js",
			"types": "./dist/types/visx/*/index.d.ts"
		}
	},
	"main": "./dist/cjs/index.js",
	"module": "./dist/mjs/index.js",
	"types": "./dist/types/index.d.ts",
	"scripts": {
		"build": "pnpm run build:prod",
		"build:dev": "tsc --build ./tsconfig.json ./tsconfig-cjs.json --watch",
		"build:prod": "tsc --build ./tsconfig.json ./tsconfig-cjs.json && node ./bin/copy-assets.js",
		"build:types": "tsc --emitDeclarationOnly --declaration --declarationDir dist/types",
		"build:webpack": "pnpm run clean-build && webpack --config webpack.config.cjs --mode production && pnpm run build:types",
		"clean": "rm -rf dist",
		"clean-build": "rm -rf dist/",
		"compile-ts": "tsc --pretty",
		"storybook": "cd ../storybook && pnpm run storybook:dev",
		"test": "TZ=UTC jest --config=tests/jest.config.cjs",
		"test-coverage": "pnpm run test --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@automattic/number-formatters": "workspace:*",
		"@babel/runtime": "7.27.6",
		"@react-spring/web": "9.7.5",
		"@visx/annotation": "^3.12.0",
		"@visx/axis": "^3.12.0",
		"@visx/curve": "^3.12.0",
		"@visx/event": "^3.12.0",
		"@visx/gradient": "^3.12.0",
		"@visx/grid": "^3.12.0",
		"@visx/group": "^3.12.0",
		"@visx/legend": "^3.12.0",
		"@visx/pattern": "^3.12.0",
		"@visx/responsive": "^3.12.0",
		"@visx/scale": "^3.12.0",
		"@visx/shape": "^3.12.0",
		"@visx/text": "^3.12.0",
		"@visx/tooltip": "^3.12.0",
		"@visx/xychart": "^3.12.0",
		"@wordpress/i18n": "^6.0.0",
		"clsx": "2.1.1",
		"date-fns": "^4.1.0",
		"deepmerge": "4.3.1",
		"fast-deep-equal": "3.1.3",
		"gridicons": "3.4.2",
		"tslib": "2.5.0"
	},
	"devDependencies": {
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@babel/core": "7.28.0",
		"@babel/plugin-transform-react-jsx": "7.27.1",
		"@babel/plugin-transform-runtime": "7.28.0",
		"@babel/preset-env": "7.28.0",
		"@babel/preset-react": "7.27.1",
		"@babel/preset-typescript": "7.27.1",
		"@storybook/addon-docs": "9.0.15",
		"@storybook/react": "9.0.15",
		"@testing-library/dom": "^10.0.0",
		"@testing-library/jest-dom": "^6.0.0",
		"@testing-library/react": "^16.0.0",
		"@testing-library/user-event": "^14.4.3",
		"@types/jest": "^30.0.0",
		"@types/react": "18.3.23",
		"@types/react-dom": "18.3.7",
		"@visx/glyph": "3.12.0",
		"@wordpress/components": "30.1.0",
		"@wordpress/element": "6.28.0",
		"babel-jest": "30.0.0",
		"babel-loader": "9.1.2",
		"css-loader": "^6.7.0",
		"fork-ts-checker-webpack-plugin": "9.0.2",
		"jest": "30.0.4",
		"jest-environment-jsdom": "30.0.4",
		"jest-extended": "5.0.3",
		"mini-css-extract-plugin": "^2.7.0",
		"postcss": "8.4.47",
		"postcss-loader": "^8.0.0",
		"postcss-modules": "6.0.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"recursive-copy": "2.0.14",
		"sass": "npm:sass-embedded@1.87.0",
		"sass-embedded": "1.87.0",
		"sass-loader": "^16.0.0",
		"storybook": "9.0.15",
		"tsconfig-paths-webpack-plugin": "4.2.0",
		"typescript": "5.8.3",
		"webpack": "^5.88.0",
		"webpack-cli": "^6.0.0"
	},
	"peerDependencies": {
		"react": "^17.0.0 || ^18.0.0",
		"react-dom": "^17.0.0 || ^18.0.0"
	}
}
