			"import": "./dist/visx/text/index.js",
			"require": "./dist/visx/text/index.cjs"
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"typesVersions": {
		"*": {
			".": [
				"./dist/index.d.ts"
			],
			"line-chart": [
				"./dist/charts/line-chart/index.d.ts"
			],
			"bar-chart": [
				"./dist/charts/bar-chart/index.d.ts"
			],
			"pie-chart": [
				"./dist/charts/pie-chart/index.d.ts"
			],
			"pie-semi-circle-chart": [
				"./dist/charts/pie-semi-circle-chart/index.d.ts"
			],
			"bar-list-chart": [
				"./dist/charts/bar-list-chart/index.d.ts"
			],
			"leaderboard-chart": [
				"./dist/charts/leaderboard-chart/index.d.ts"
			],
			"conversion-funnel-chart": [
				"./dist/charts/conversion-funnel-chart/index.d.ts"
			],
			"tooltip": [
				"./dist/components/tooltip/index.d.ts"
			],
			"legend": [
				"./dist/components/legend/index.d.ts"
			],
			"sparkline": [
				"./dist/components/sparkline/index.d.ts"
			],
			"trend-indicator": [
				"./dist/components/trend-indicator/index.d.ts"
			],
			"hooks": [
				"./dist/hooks/index.d.ts"
			],
			"providers": [
				"./dist/providers/index.d.ts"
			],
			"utils": [
				"./dist/utils/index.d.ts"
			],
			"visx/group": [
				"./dist/visx/group/index.d.ts"
			],
			"visx/legend": [
				"./dist/visx/legend/index.d.ts"
			],
			"visx/text": [
				"./dist/visx/text/index.d.ts"
			]
		}
	},
	"scripts": {
		"build": "pnpm run build:prod",
		"build:prod": "tsup",
		"storybook": "cd ../storybook && pnpm run storybook:dev",
		"test": "TZ=UTC jest --config=tests/jest.config.cjs",
		"test-coverage": "pnpm run test --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@automattic/number-formatters": "workspace:*",
		"@babel/runtime": "7.28.4",
		"@react-spring/web": "9.7.5",
