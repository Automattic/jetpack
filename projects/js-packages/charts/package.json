{
	"name": "@automattic/charts",
	"version": "0.32.0",
	"description": "Display charts within Automattic products.",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/js-packages/charts/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[JS Package] Charts"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/js-packages/charts"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"type": "module",
	"exports": {
		".": {
			"jetpack:src": "./src/index.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js"
		},
		"./bar-chart": {
			"jetpack:src": "./src/components/bar-chart/index.ts",
			"import": "./dist/esm/components/bar-chart/index.js",
			"require": "./dist/cjs/components/bar-chart/index.js"
		},
		"./bar-list-chart": {
			"jetpack:src": "./src/components/bar-list-chart/index.ts",
			"import": "./dist/esm/components/bar-list-chart/index.js",
			"require": "./dist/cjs/components/bar-list-chart/index.js"
		},
		"./conversion-funnel-chart": {
			"jetpack:src": "./src/components/conversion-funnel-chart/index.ts",
			"import": "./dist/esm/components/conversion-funnel-chart/index.js",
			"require": "./dist/cjs/components/conversion-funnel-chart/index.js"
		},
		"./hooks": {
			"jetpack:src": "./src/hooks/index.ts",
			"import": "./dist/esm/hooks/index.js",
			"require": "./dist/cjs/hooks/index.js"
		},
		"./leaderboard-chart": {
			"jetpack:src": "./src/components/leaderboard-chart/index.ts",
			"import": "./dist/esm/components/leaderboard-chart/index.js",
			"require": "./dist/cjs/components/leaderboard-chart/index.js"
		},
		"./legend": {
			"jetpack:src": "./src/components/legend/index.ts",
			"import": "./dist/esm/components/legend/index.js",
			"require": "./dist/cjs/components/legend/index.js"
		},
		"./line-chart": {
			"jetpack:src": "./src/components/line-chart/index.ts",
			"import": "./dist/esm/components/line-chart/index.js",
			"require": "./dist/cjs/components/line-chart/index.js"
		},
		"./pie-chart": {
			"jetpack:src": "./src/components/pie-chart/index.ts",
			"import": "./dist/esm/components/pie-chart/index.js",
			"require": "./dist/cjs/components/pie-chart/index.js"
		},
		"./pie-semi-circle-chart": {
			"jetpack:src": "./src/components/pie-semi-circle-chart/index.ts",
			"import": "./dist/esm/components/pie-semi-circle-chart/index.js",
			"require": "./dist/cjs/components/pie-semi-circle-chart/index.js"
		},
		"./providers": {
			"jetpack:src": "./src/providers/index.ts",
			"import": "./dist/esm/providers/index.js",
			"require": "./dist/cjs/providers/index.js"
		},
		"./tooltip": {
			"jetpack:src": "./src/components/tooltip/index.ts",
			"import": "./dist/esm/components/tooltip/index.js",
			"require": "./dist/cjs/components/tooltip/index.js"
		},
		"./visx/group": {
			"jetpack:src": "./src/visx/group/index.ts",
			"import": "./dist/esm/visx/group/index.js",
			"require": "./dist/cjs/visx/group/index.js"
		},
		"./visx/legend": {
			"jetpack:src": "./src/visx/legend/index.ts",
			"import": "./dist/esm/visx/legend/index.js",
			"require": "./dist/cjs/visx/legend/index.js"
		},
		"./visx/text": {
			"jetpack:src": "./src/visx/text/index.ts",
			"import": "./dist/esm/visx/text/index.js",
			"require": "./dist/cjs/visx/text/index.js"
		}
	},
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types/index.d.ts"
			],
			"line-chart": [
				"./dist/types/components/line-chart/index.d.ts"
			],
			"bar-chart": [
				"./dist/types/components/bar-chart/index.d.ts"
			],
			"pie-chart": [
				"./dist/types/components/pie-chart/index.d.ts"
			],
			"pie-semi-circle-chart": [
				"./dist/types/components/pie-semi-circle-chart/index.d.ts"
			],
			"bar-list-chart": [
				"./dist/types/components/bar-list-chart/index.d.ts"
			],
			"leaderboard-chart": [
				"./dist/types/components/leaderboard-chart/index.d.ts"
			],
			"conversion-funnel-chart": [
				"./dist/types/components/conversion-funnel-chart/index.d.ts"
			],
			"tooltip": [
				"./dist/types/components/tooltip/index.d.ts"
			],
			"legend": [
				"./dist/types/components/legend/index.d.ts"
			],
			"hooks": [
				"./dist/types/hooks/index.d.ts"
			],
			"providers": [
				"./dist/types/providers/index.d.ts"
			],
			"visx/group": [
				"./dist/types/visx/group/index.d.ts"
			],
			"visx/legend": [
				"./dist/types/visx/legend/index.d.ts"
			],
			"visx/text": [
				"./dist/types/visx/text/index.d.ts"
			]
		}
	},
	"scripts": {
		"build": "pnpm run build:prod",
		"build:dev": "rollup -c --environment NODE_ENV:development",
		"build:prod": "pnpm run clean && rollup -c --environment NODE_ENV:production",
		"build:types": "tsc --emitDeclarationOnly --declaration --declarationDir dist/types",
		"build:webpack": "pnpm run clean-build && webpack --config webpack.config.cjs --mode production && pnpm run build:types",
		"clean": "rm -rf dist",
		"clean-build": "rm -rf dist/",
		"compile-ts": "tsc --pretty",
		"storybook": "cd ../storybook && pnpm run storybook:dev",
		"test": "TZ=UTC jest --config=tests/jest.config.cjs",
		"test-coverage": "pnpm run test --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@automattic/number-formatters": "workspace:*",
		"@babel/runtime": "7.27.6",
		"@react-spring/web": "9.7.5",
		"@visx/annotation": "^3.12.0",
		"@visx/axis": "^3.12.0",
		"@visx/curve": "^3.12.0",
		"@visx/event": "^3.12.0",
		"@visx/gradient": "^3.12.0",
		"@visx/grid": "^3.12.0",
		"@visx/group": "^3.12.0",
		"@visx/legend": "^3.12.0",
		"@visx/pattern": "^3.12.0",
		"@visx/responsive": "^3.12.0",
		"@visx/scale": "^3.12.0",
		"@visx/shape": "^3.12.0",
		"@visx/text": "^3.12.0",
		"@visx/tooltip": "^3.12.0",
		"@visx/xychart": "^3.12.0",
		"@wordpress/i18n": "^6.0.0",
		"clsx": "2.1.1",
		"date-fns": "^4.1.0",
		"deepmerge": "4.3.1",
		"fast-deep-equal": "3.1.3",
		"gridicons": "3.4.2",
		"tslib": "2.5.0"
	},
	"devDependencies": {
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@babel/core": "7.28.0",
		"@babel/plugin-transform-react-jsx": "7.27.1",
		"@babel/plugin-transform-runtime": "7.28.0",
		"@babel/preset-env": "7.28.0",
		"@babel/preset-react": "7.27.1",
		"@babel/preset-typescript": "7.27.1",
		"@rollup/plugin-commonjs": "26.0.1",
		"@rollup/plugin-json": "6.1.0",
		"@rollup/plugin-node-resolve": "15.3.0",
		"@rollup/plugin-terser": "0.4.3",
		"@rollup/plugin-typescript": "12.1.0",
		"@storybook/addon-docs": "9.0.15",
		"@storybook/react": "9.0.15",
		"@testing-library/dom": "^10.0.0",
		"@testing-library/jest-dom": "^6.0.0",
		"@testing-library/react": "^16.0.0",
		"@testing-library/user-event": "^14.4.3",
		"@types/jest": "^30.0.0",
		"@types/react": "18.3.23",
		"@types/react-dom": "18.3.7",
		"@visx/glyph": "3.12.0",
		"@wordpress/components": "30.3.0",
		"@wordpress/element": "6.30.0",
		"babel-jest": "30.0.0",
		"babel-loader": "9.1.2",
		"css-loader": "^6.7.0",
		"fork-ts-checker-webpack-plugin": "9.0.2",
		"jest": "30.0.4",
		"jest-environment-jsdom": "30.0.4",
		"jest-extended": "5.0.3",
		"mini-css-extract-plugin": "^2.7.0",
		"postcss": "8.4.47",
		"postcss-loader": "^8.0.0",
		"postcss-modules": "6.0.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"rollup": "3.29.5",
		"rollup-plugin-dts": "6.1.1",
		"rollup-plugin-peer-deps-external": "2.2.4",
		"rollup-plugin-postcss": "4.0.2",
		"sass": "npm:sass-embedded@1.87.0",
		"sass-embedded": "1.87.0",
		"sass-loader": "^16.0.0",
		"storybook": "9.0.15",
		"typescript": "5.8.3",
		"webpack": "^5.88.0",
		"webpack-cli": "^6.0.0"
	},
	"peerDependencies": {
		"react": "^17.0.0 || ^18.0.0",
		"react-dom": "^17.0.0 || ^18.0.0"
	}
}
