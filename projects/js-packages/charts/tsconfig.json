{
	"extends": "jetpack-js-tools/tsconfig.base.json",
	"compilerOptions": {
		"target": "esnext",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"declaration": true,
		"noEmit": false,
		"outDir": "dist/mjs",
		"declarationDir": "dist/types",
		"rootDir": "src"
	},
	// List all sources and source-containing subdirs.
	"include": [ "./src" ],
	"exclude": [ "tests", "**/*.test.*", "stories", "**/*.stories.*" ]
}
