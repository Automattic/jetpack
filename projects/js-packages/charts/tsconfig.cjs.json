{
	"extends": "jetpack-js-tools/tsconfig.tsc.json",
	"compilerOptions": {
		"composite": true,
		"target": "esnext",
		"moduleResolution": "bundler",
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"outDir": "dist/esm",
		"declarationDir": "dist/types",
		"rootDir": "src"
	},
	"include": [ "./src" ],
	"exclude": [ "tests", "**/*.test.*", "stories", "**/*.stories.*" ]
}
