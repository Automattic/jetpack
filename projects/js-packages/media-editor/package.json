{
	"name": "@automattic/media-editor",
	"version": "0.1.0",
	"description": "Media Editor Components Package",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/js-packages/media-editor/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[JS Package] Media Editor"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/js-packages/media-editor"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"type": "module",
	"exports": {
		".": {
			"jetpack:src": "./index.ts",
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		}
	},
	"scripts": {
		"build": "pnpm run clean && pnpm run compile-ts",
		"clean": "rm -rf build/",
		"compile-ts": "tsc --pretty --project tsconfig.build.json",
		"typecheck": "tsc --noEmit"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"dependencies": {
		"@automattic/agenttic-client": "link:../../../../agenttic/packages/agenttic-client",
		"@automattic/agenttic-ui": "link:../../../../agenttic/packages/agenttic-ui",
		"@automattic/jetpack-components": "workspace:*",
		"@babel/runtime": "^7",
		"@wordpress/blob": "4.31.0",
		"@wordpress/block-editor": "14.19.0",
		"@wordpress/browserslist-config": "6.31.0",
		"@wordpress/components": "30.4.0",
		"@wordpress/compose": "7.31.0",
		"@wordpress/core-data": "7.31.0",
		"@wordpress/data": "10.31.0",
		"@wordpress/dom": "4.31.0",
		"@wordpress/editor": "14.19.0",
		"@wordpress/element": "6.31.0",
		"@wordpress/i18n": "6.4.0",
		"@wordpress/icons": "10.31.0",
		"@wordpress/keycodes": "4.31.0",
		"@wordpress/media-utils": "5.31.0",
		"@wordpress/notices": "5.31.0",
		"@wordpress/private-apis": "1.31.0",
		"clsx": "2.1.1"
	},
	"devDependencies": {
		"@types/react": "18.3.23",
		"@types/react-dom": "18.3.7",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	}
}
