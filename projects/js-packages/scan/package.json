{
	"name": "@automattic/jetpack-scan",
	"version": "1.3.0",
	"private": false,
	"description": "A JS client for consuming Jetpack Scan services",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/js-packages/scan/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[JS Package] Scan"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/jetpack-scan.git"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"type": "module",
	"exports": {
		".": {
			"jetpack:src": "./src/index.ts",
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		}
	},
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"scripts": {
		"build": "pnpm run clean && pnpm run compile-ts && pnpm run copy-scss",
		"clean": "rm -rf build/",
		"compile-ts": "tsgo --pretty",
		"copy-scss": "node ./tools/copy-scss-to-build.mjs",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest",
		"test-coverage": "pnpm run test --coverage",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@automattic/jetpack-api": "workspace:*",
		"@automattic/jetpack-base-styles": "workspace:*",
		"@automattic/jetpack-components": "workspace:*",
		"@wordpress/api-fetch": "7.44.0",
		"@wordpress/components": "32.6.0",
		"@wordpress/dataviews": "14.1.0",
		"@wordpress/date": "5.44.0",
		"@wordpress/element": "6.44.0",
		"@wordpress/i18n": "6.17.0",
		"@wordpress/icons": "12.2.0",
		"@wordpress/theme": "0.11.0",
		"@wordpress/ui": "0.11.0",
		"@wordpress/url": "4.44.0",
		"debug": "4.4.3"
	},
	"devDependencies": {
		"@storybook/addon-docs": "10.3.5",
		"@storybook/react": "10.3.5",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/jest": "30.0.0",
		"@types/react": "18.3.28",
		"@typescript/native-preview": "7.0.0-dev.20260225.1",
		"jest": "30.3.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"storybook": "10.3.5",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	}
}
