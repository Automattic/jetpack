{
	"name": "@automattic/jetpack-scan",
	"version": "1.2.1",
	"private": false,
	"description": "A JS client for consuming Jetpack Scan services",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/js-packages/scan/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[JS Package] Scan"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/js-packages/scan"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"type": "module",
	"exports": {
		".": {
			"jetpack:src": "./src/index.ts",
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		}
	},
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"scripts": {
		"build": "pnpm run clean && pnpm run compile-ts",
		"clean": "rm -rf build/",
		"compile-ts": "tsc --pretty",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest",
		"test-coverage": "pnpm run test --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@automattic/jetpack-api": "workspace:*",
		"@automattic/jetpack-base-styles": "workspace:*",
		"@automattic/jetpack-components": "workspace:*",
		"@wordpress/api-fetch": "7.37.1-next.v.0",
		"@wordpress/components": "32.0.1-next.v.0",
		"@wordpress/dataviews": "11.2.1-next.v.0",
		"@wordpress/date": "5.37.2-next.v.0",
		"@wordpress/element": "6.37.1-next.v.0",
		"@wordpress/i18n": "6.10.1-next.v.0",
		"@wordpress/icons": "11.4.1-next.v.0",
		"@wordpress/url": "4.37.1-next.v.0",
		"debug": "4.4.3"
	},
	"devDependencies": {
		"@storybook/addon-docs": "10.1.10",
		"@storybook/react": "10.1.10",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.0",
		"@types/jest": "30.0.0",
		"@types/react": "18.3.27",
		"jest": "30.2.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"storybook": "10.1.10",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	}
}
