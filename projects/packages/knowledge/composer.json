{
	"name": "automattic/jetpack-knowledge",
	"description": "Knowledge runtime and Guidelines screen polyfill.",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"automattic/jetpack-assets": "@dev",
		"automattic/jetpack-wp-build-polyfills": "@dev"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^4.0.0",
		"automattic/phpunit-select-config": "@dev",
		"automattic/jetpack-test-environment": "@dev"
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"scripts": {
		"build-development": "pnpm run build",
		"build-production": "pnpm run build-production",
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-php": [
			"@composer phpunit"
		],
		"test-php-coverage": [
			"php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\""
		],
		"test-js": "pnpm run test",
		"typecheck": "pnpm run typecheck"
	},
	"repositories": [
		{
			"type": "path",
			"url": "../../packages/*",
			"options": {
				"monorepo": true
			}
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autotagger": false,
		"mirror-repo": "Automattic/jetpack-knowledge",
		"branch-alias": {
			"dev-trunk": "0.1.x-dev"
		},
		"textdomain": "jetpack-knowledge",
		"version-constants": {
			"::PACKAGE_VERSION": "src/class-knowledge.php"
		}
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	}
}
