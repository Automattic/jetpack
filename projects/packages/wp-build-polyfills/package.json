{
	"name": "@automattic/jetpack-wp-build-polyfills",
	"version": "0.7.1",
	"private": true,
	"description": "Polyfills for WordPress Core packages not available or incomplete in older WP versions",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/packages/wp-build-polyfills/#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/packages/wp-build-polyfills"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"bin": {
		"emit-widget-strings": "bin/emit-widget-strings.js",
		"provide-boot-asset-file": "bin/provide-boot-asset-file.js",
		"stamp-textdomains": "bin/stamp-textdomains.js",
		"strip-unminified-prod": "bin/strip-unminified-prod.js"
	},
	"scripts": {
		"build": "pnpm run clean && webpack && node bin/validate-boot-asset.js && node bin/validate-export-contract.js",
		"build-production": "NODE_ENV=production BABEL_ENV=production pnpm run build",
		"check-contracts": "node bin/validate-export-contract.js",
		"clean": "rm -rf build/",
		"test": "node --test 'tests/js/**/*.test.js'",
		"test-coverage": "c8 --report-dir=\"$COVERAGE_DIR\" --temp-directory=\"$ARTIFACTS_DIR/v8\" pnpm run test"
	},
	"devDependencies": {
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@types/react": "19.3.0",
		"@wordpress/a11y": "^5.0.0",
		"@wordpress/admin-ui": "3.0.0",
		"@wordpress/boot": "^0.25.0",
		"@wordpress/browserslist-config": "7.0.0",
		"@wordpress/build": "0.26.0",
		"@wordpress/compose": "9.0.0",
		"@wordpress/dataviews": "21.0.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/lazy-editor": "^2.0.0",
		"@wordpress/notices": "^6.0.0",
		"@wordpress/private-apis": "3.0.0",
		"@wordpress/react-inert-value": "^2.0.0",
		"@wordpress/rich-text": "8.0.0",
		"@wordpress/route": "^0.24.0",
		"@wordpress/theme": "^3.0.0",
		"@wordpress/ui": "^0.25.0",
		"@wordpress/widget-primitives": "0.10.0",
		"browserslist": "^4.24.0",
		"c8": "^11.0.0",
		"webpack": "^5.104.1",
		"webpack-cli": "^7.0.0"
	},
	"optionalDependencies": {
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"dependencies": {
		"@automattic/babel-plugin-replace-textdomain": "workspace:*",
		"@babel/core": "7.29.7",
		"@wordpress/views": "~3.0.0"
	}
}
