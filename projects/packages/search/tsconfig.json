{
	"extends": "jetpack-js-tools/tsconfig.base.json",
	// esbuild (wp-build) resolves the dashboard's bare `components/*`, `hooks/*` and
	// `store` imports through these paths, as webpack's `resolve.modules` does.
	"compilerOptions": {
		"paths": {
			"components/*": [ "./src/dashboard/components/*" ],
			"hooks/*": [ "./src/dashboard/hooks/*" ],
			"store": [ "./src/dashboard/store" ]
		}
	},
	"include": [ "./packages/*/src", "./routes/**/*", "./src/dashboard" ]
}
