+	/**
+	 * On the main frontend search query, when the request resolves to a
+	 * singular permalink that hosts at least one Jetpack Search block,
+	 * drop the `s` query var so WordPress doesn't AND a `post_content
+	 * LIKE` clause into the singular post lookup (which empties $posts
+	 * and trips handle_404()).
+	 *
+	 * `$_GET['s']` is left intact so the Interactivity API store can
+	 * still seed `searchQuery` from the URL on first paint and run the
+	 * API fetch after hydration.
+	 *
+	 * @param \WP_Query $query Main query about to run.
+	 * @return void
+	 */
+	public static function unset_search_on_singular_block_host( $query ) {
+		if ( is_admin() || ! $query->is_main_query() || ! $query->is_search() ) {
+			return;
+		}
+		// At pre_get_posts time, is_singular() may not be reliable yet
+		// because tax/page parsing has happened but template loading
+		// hasn't — but pagename/name/page_id query vars are populated
+		// from rewrite resolution at this point and are sufficient.
+		$is_singular_request = $query->get( 'pagename' )
+			|| $query->get( 'name' )
+			|| $query->get( 'page_id' );
+		if ( ! $is_singular_request ) {
+			return;
+		}
+		$post = get_post();
+		if ( ! $post || ! self::post_hosts_search_blocks( $post ) ) {
+			return;
+		}
+		$query->set( 's', '' );
+	}
+
+	/**
+	 * Whether a post's content tree contains any registered Jetpack
+	 * Search 3.0 block (any name in SEARCH_BLOCK_NAMES). Walks
+	 * innerBlocks recursively.
+	 *
+	 * @param \WP_Post $post Post to inspect.
+	 * @return bool
+	 */
+	public static function post_hosts_search_blocks( $post ): bool {
+		if ( empty( $post->post_content ) || ! function_exists( 'parse_blocks' ) ) {
+			return false;
+		}
+		$found = false;
+		$walk  = static function ( array $blocks ) use ( &$walk, &$found ) {
+			foreach ( $blocks as $block ) {
+				if ( $found ) {
+					return;
+				}
+				$name = $block['blockName'] ?? '';
+				if ( in_array( $name, self::SEARCH_BLOCK_NAMES, true ) ) {
+					$found = true;
+					return;
+				}
+				if ( ! empty( $block['innerBlocks'] ) && is_array( $block['innerBlocks'] ) ) {
+					$walk( $block['innerBlocks'] );
+				}
+			}
+		};
+		$walk( parse_blocks( $post->post_content ) );
+		return $found;
+	}
