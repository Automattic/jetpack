{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jetpack/search-results",
	"version": "0.2.0",
	"title": "Search Results",
	"category": "jetpack-search",
	"icon": "list-view",
	"description": "Renders Jetpack Search results, plus the empty-state and error messages for the same region.",
	"attributes": {
		"layout": {
			"type": "string",
			"enum": [ "compact", "expanded", "product" ],
			"default": "expanded"
		},
		"noResultsMessage": { "type": "string", "default": "" },
		"errorMessage": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"interactivity": true
	},
	"textdomain": "jetpack-search-pkg",
	"render": "file:./render.php",
	"viewScriptModule": "file:../../../../build/search-blocks/search-results.js",
	"style": "file:../../../../build/search-blocks/search-results.css"
}
