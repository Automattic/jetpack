		"postcss-loader": "8.2.0",
		"sass-embedded": "1.87.0",
		"sass-loader": "16.0.5",
		"size-limit": "11.2.0",
		"webpack": "5.101.3",
		"webpack-cli": "6.0.1"
	}
}
