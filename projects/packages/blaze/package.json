{
	"name": "@automattic/jetpack-blaze",
	"private": true,
	"description": "Attract high-quality traffic to your site using Blaze. Using this service, you can advertise a post or page on some of the millions of pages across WordPress.com and Tumblr from just $5 per day.",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/packages/blaze/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[Package] Blaze"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/packages/blaze"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"scripts": {
		"build": "pnpm run clean && pnpm run build-client && pnpm run build:wp-build && pnpm run build:stamp-textdomains && pnpm run build:boot-asset",
		"build:boot-asset": "provide-boot-asset-file",
		"build:stamp-textdomains": "stamp-textdomains",
		"build:strip-unminified-prod": "strip-unminified-prod",
		"build:wp-build": "wp-build",
		"build-client": "webpack",
		"build-production": "pnpm run clean && NODE_ENV=production BABEL_ENV=production pnpm run build-client && NODE_ENV=production BABEL_ENV=production pnpm run build:wp-build && pnpm run build:stamp-textdomains && pnpm run build:strip-unminified-prod && pnpm run build:boot-asset && pnpm run validate",
		"clean": "rm -rf build/",
		"typecheck": "tsgo --noEmit",
		"validate": "pnpm exec validate-es --no-error-on-unmatched-pattern build/",
		"watch": "concurrently 'pnpm:build-client --watch' 'pnpm:watch:wp-build'",
		"watch:wp-build": "wp-build --watch"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"dependencies": {
		"@automattic/jetpack-analytics": "workspace:*",
		"@automattic/jetpack-components": "workspace:*",
		"@automattic/jetpack-shared-extension-utils": "workspace:*",
		"@automattic/number-formatters": "workspace:*",
		"@jetpack-blaze/init": "link:packages/init",
		"@tanstack/react-query": "^5.90.8",
		"@wordpress/admin-ui": "3.1.0",
		"@wordpress/api-fetch": "8.1.0",
		"@wordpress/base-styles": "15.0.0",
		"@wordpress/block-editor": "20.0.0",
		"@wordpress/components": "44.0.0",
		"@wordpress/compose": "9.1.0",
		"@wordpress/data": "11.1.0",
		"@wordpress/edit-post": "9.1.0",
		"@wordpress/editor": "16.1.0",
		"@wordpress/element": "10.1.0",
		"@wordpress/i18n": "7.1.0",
		"@wordpress/icons": "20.0.0",
		"@wordpress/plugins": "8.1.0",
		"@wordpress/primitives": "5.1.0",
		"@wordpress/route": "0.25.0",
		"@wordpress/ui": "0.26.0",
		"@wordpress/url": "5.1.0",
		"clsx": "2.1.1",
		"cookie": "1.0.2",
		"moment": "2.31.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"uplot": "1.6.31",
		"uplot-react": "1.1.4"
	},
	"devDependencies": {
		"@automattic/jetpack-base-styles": "workspace:*",
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.13",
		"@babel/runtime": "7.29.13",
		"@types/react": "19.3.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@wordpress/browserslist-config": "7.1.0",
		"@wordpress/build": "0.27.0",
		"@wordpress/theme": "4.0.0",
		"browserslist": "^4.24.0",
		"concurrently": "10.0.5",
		"sass-embedded": "1.97.3",
		"sass-loader": "16.0.5",
		"webpack": "5.112.2",
		"webpack-cli": "7.2.1"
	},
	"wpPlugin": {
		"name": "jetpack_blaze",
		"scriptGlobal": "jetpackBlaze",
		"packageNamespace": "jetpack-blaze",
		"handlePrefix": "jetpack-blaze",
		"pages": [
			{
				"id": "jetpack-blaze-dashboard",
				"init": [
					"@jetpack-blaze/init"
				]
			}
		]
	}
}
