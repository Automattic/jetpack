{
	"name": "@automattic/jetpack-premium-analytics",
	"version": "0.11.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm run clean && pnpm run build:wp-build && pnpm run build:stamp-textdomains && pnpm run build:boot-asset",
		"build:boot-asset": "provide-boot-asset-file",
		"build:stamp-textdomains": "stamp-textdomains",
		"build:strip-unminified-prod": "strip-unminified-prod",
		"build:wp-build": "wp-build",
		"build-production": "NODE_ENV=production BABEL_ENV=production pnpm run build && pnpm run build:strip-unminified-prod && pnpm run validate",
		"clean": "rm -rf build/",
		"storybook": "cd ../../js-packages/storybook && pnpm run storybook:dev",
		"test": "PA_TEST_GROUPS=1 TZ=UTC LC_ALL=en_US.UTF-8 jest --config=tests/jest.config.cjs",
		"test-coverage": "pnpm run test --coverage",
		"test-tz": "for tz in America/Los_Angeles Asia/Tokyo; do TZ=$tz LC_ALL=en_US.UTF-8 jest --config=tests/jest.tz.config.cjs || exit 1; done",
		"typecheck": "tsgo --noEmit",
		"validate": "pnpm exec validate-es --no-error-on-unmatched-pattern build/",
		"watch": "wp-build --watch"
	},
	"wpPlugin": {
		"name": "jpa",
		"packageNamespace": "jetpack-premium-analytics",
		"handlePrefix": "jetpack-premium-analytics",
		"pages": [
			{
				"id": "jetpack-premium-analytics",
				"init": [
					"@jetpack-premium-analytics/init"
				]
			}
		],
		"externalNamespaces": {
			"wordpress": {
				"global": "wp",
				"handlePrefix": "wp"
			}
		}
	},
	"dependencies": {
		"@automattic/charts": "workspace:*",
		"@automattic/jetpack-analytics": "workspace:*",
		"@automattic/jetpack-connection": "workspace:*",
		"@automattic/jetpack-script-data": "workspace:*",
		"@automattic/number-formatters": "workspace:*",
		"@date-fns/tz": "1.5.0",
		"@jetpack-premium-analytics/data": "link:packages/data",
		"@jetpack-premium-analytics/datetime": "link:packages/datetime",
		"@jetpack-premium-analytics/externals": "link:packages/externals",
		"@jetpack-premium-analytics/fields": "link:packages/fields",
		"@jetpack-premium-analytics/formatters": "link:packages/formatters",
		"@jetpack-premium-analytics/icons": "link:packages/icons",
		"@jetpack-premium-analytics/init": "link:packages/init",
		"@jetpack-premium-analytics/routing": "link:packages/routing",
		"@jetpack-premium-analytics/site-sync": "link:packages/site-sync",
		"@jetpack-premium-analytics/ui": "link:packages/ui",
		"@jetpack-premium-analytics/widgets-toolkit": "link:packages/widgets-toolkit",
		"@tanstack/react-query": "5.102.8",
		"@visx/scale": "4.0.0",
		"@wordpress/admin-ui": "2.12.0",
		"@wordpress/api-fetch": "7.57.0",
		"@wordpress/boot": "0.24.0",
		"@wordpress/components": "42.0.0",
		"@wordpress/compose": "8.10.0",
		"@wordpress/core-data": "8.2.0",
		"@wordpress/data": "10.57.0",
		"@wordpress/dataviews": "20.0.0",
		"@wordpress/date": "5.57.0",
		"@wordpress/element": "9.0.0",
		"@wordpress/html-entities": "4.57.0",
		"@wordpress/i18n": "^6.9.0",
		"@wordpress/icons": "^18.0.0",
		"@wordpress/preferences": "4.57.0",
		"@wordpress/primitives": "4.57.0",
		"@wordpress/private-apis": "2.0.0",
		"@wordpress/react-inert-value": "1.0.0",
		"@wordpress/route": "0.23.0",
		"@wordpress/theme": "2.3.0",
		"@wordpress/ui": "0.24.0",
		"@wordpress/url": "4.57.0",
		"@wordpress/widget-dashboard": "0.9.0",
		"@wordpress/widget-primitives": "0.9.0",
		"clsx": "2.1.1",
		"date-fns": "4.4.0",
		"fast-deep-equal": "^3.1.3",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@automattic/jetpack-premium-analytics-sdk": "workspace:*",
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.7",
		"@storybook/react": "10.4.6",
		"@tanstack/react-query-devtools": "5.102.8",
		"@tanstack/react-router": "1.167.1",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/jest": "30.0.0",
		"@types/react": "18.3.31",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@wordpress/base-styles": "13.3.0",
		"@wordpress/build": "0.25.0",
		"browserslist": "4.28.9",
		"jest": "30.5.1",
		"storybook": "10.4.6",
		"typescript": "6.0.3"
	}
}
