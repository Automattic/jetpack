{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "build-module",
		"rootDir": "."
	},
	"include": [ "routes/**/*" ],
	"exclude": [ "node_modules", "build", "build-module" ]
}
