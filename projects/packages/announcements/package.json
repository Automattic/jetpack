{
	"version": "0.1.0",
	"private": true,
	"description": "A product-agnostic channel to tell Jetpack users what is new.",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/packages/announcements/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[Package] Announcements"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/packages/announcements"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"type": "module",
	"scripts": {
		"build": "pnpm run clean && pnpm run build:wp-build && pnpm run build:stamp-textdomains",
		"build:stamp-textdomains": "stamp-textdomains",
		"build:strip-unminified-prod": "strip-unminified-prod",
		"build:wp-build": "wp-build",
		"build-production": "NODE_ENV=production BABEL_ENV=production pnpm run build && pnpm run build:strip-unminified-prod",
		"clean": "rm -rf build/",
		"test": "jest",
		"test-coverage": "pnpm run test --coverage",
		"typecheck": "tsgo --noEmit",
		"watch": "wp-build --watch"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"dependencies": {
		"@wordpress/core-data": "9.2.0",
		"@wordpress/data": "11.2.0",
		"@wordpress/date": "6.2.0",
		"@wordpress/element": "10.2.0",
		"@wordpress/i18n": "7.2.0",
		"@wordpress/icons": "21.0.0",
		"@wordpress/preferences": "5.2.0",
		"@wordpress/ui": "0.27.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@automattic/jetpack-announcements": "workspace:*",
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.13",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/jest": "30.0.0",
		"@types/react": "19.3.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@wordpress/browserslist-config": "7.2.0",
		"@wordpress/build": "0.28.0",
		"jest": "30.5.2",
		"typescript": "6.0.3"
	},
	"wpPlugin": {
		"name": "jetpack_announcements",
		"packageNamespace": "jetpack-announcements",
		"handlePrefix": "jetpack-announcements"
	}
}
