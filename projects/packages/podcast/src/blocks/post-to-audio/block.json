{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jetpack/post-to-audio",
	"title": "Post to Audio",
	"description": "Generate a single-voice audio narration of this post and insert it as an audio block.",
	"keywords": [ "audio", "narration", "tts", "text to speech", "voice" ],
	"version": "1.0.0",
	"textdomain": "jetpack-podcast",
	"category": "media",
	"icon": "<svg viewBox='0 0 24 24' width='24' height='24' xmlns='http://www.w3.org/2000/svg'><path d='M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zm6.5 9a.75.75 0 0 1 .75.75 7.25 7.25 0 0 1-6.5 7.213V22h2.5a.75.75 0 0 1 0 1.5h-6.5a.75.75 0 0 1 0-1.5h2.5v-2.037A7.25 7.25 0 0 1 4.75 12.75a.75.75 0 0 1 1.5 0 5.75 5.75 0 0 0 11.5 0 .75.75 0 0 1 .75-.75z'/></svg>",
	"supports": {
		"html": false,
		"multiple": false,
		"reusable": false,
		"customClassName": false,
		"className": false
	},
	"attributes": {
		"voice": {
			"type": "string",
			"default": ""
		},
		"style": {
			"type": "string",
			"default": ""
		},
		"pace": {
			"type": "string",
			"default": ""
		},
		"music": {
			"type": "string",
			"default": ""
		},
		"musicGain": {
			"type": "number"
		},
		"editedText": {
			"type": "string",
			"default": ""
		},
		"attachmentId": {
			"type": "integer"
		},
		"audioUrl": {
			"type": "string",
			"default": ""
		},
		"voiceUsed": {
			"type": "string",
			"default": ""
		}
	}
}
