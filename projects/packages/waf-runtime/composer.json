{
	"name": "automattic/jetpack-waf-runtime",
	"description": "Web Application Firewall Runtime",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.2",
		"automattic/jetpack-ip": "@dev",
		"wikimedia/aho-corasick": "^1.0"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^1.1.1",
		"automattic/jetpack-changelogger": "@dev"
	},
	"scripts": {
		"phpunit": [
			"./vendor/phpunit/phpunit/phpunit --colors=always"
		],
		"test-coverage": [
			"php -dpcov.directory=. ./vendor/bin/phpunit --coverage-php \"$COVERAGE_DIR/php.cov\""
		],
		"test-php": [
			"@composer phpunit"
		]
	},
	"repositories": [
		{
			"type": "path",
			"url": "../../packages/*",
			"options": {
				"monorepo": true
			}
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"branch-alias": {
			"dev-trunk": "0.1.x-dev"
		},
		"textdomain": "jetpack-waf-runtime",
		"version-constants": {
			"::PACKAGE_VERSION": "src/class-waf-runtime.php"
		}
	}
}
