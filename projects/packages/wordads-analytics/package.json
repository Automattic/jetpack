{
	"name": "@automattic/jetpack-wordads-analytics",
	"version": "0.1.0-alpha",
	"private": true,
	"description": "WordAds: the Ads section and widgets of the Premium Analytics dashboard.",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/packages/wordads-analytics/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[Package] Wordads Analytics"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/packages/wordads-analytics"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"type": "module",
	"scripts": {
		"build": "pnpm run clean && pnpm run build:wp-build && pnpm run build:stamp-textdomains",
		"build:stamp-textdomains": "stamp-textdomains",
		"build:strip-unminified-prod": "strip-unminified-prod",
		"build:wp-build": "wp-build",
		"build-production": "NODE_ENV=production BABEL_ENV=production pnpm run build && pnpm run build:strip-unminified-prod",
		"clean": "rm -rf build/",
		"typecheck": "tsgo --noEmit",
		"watch": "wp-build --watch"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"dependencies": {
		"@automattic/jetpack-premium-analytics-sdk": "workspace:*",
		"@wordpress/element": "8.7.0",
		"@wordpress/i18n": "6.28.0",
		"@wordpress/icons": "16.0.0",
		"@wordpress/widget-primitives": "0.7.0",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.7",
		"@types/react": "18.3.31",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@wordpress/browserslist-config": "6.55.0",
		"@wordpress/build": "0.23.0",
		"typescript": "6.0.3"
	},
	"wpPlugin": {
		"name": "jetpack_wordads_analytics",
		"packageNamespace": "jetpack-wordads-analytics",
		"handlePrefix": "jetpack-wordads-analytics",
		"externalNamespaces": {
			"automattic": {
				"global": "automattic",
				"handlePrefix": "automattic"
			}
		}
	}
}
