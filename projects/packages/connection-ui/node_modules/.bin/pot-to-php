esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/christos/Documents/code/work_related/automattic/jetpack/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="$NODE_PATH:/Users/christos/Documents/code/work_related/automattic/jetpack/node_modules/.pnpm/node_modules"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../node_modules/.pnpm/@wordpress+i18n@4.12.0/node_modules/@wordpress/i18n/tools/pot-to-php.js" "$@"
else
  exec node  "$basedir/../../../../../node_modules/.pnpm/@wordpress+i18n@4.12.0/node_modules/@wordpress/i18n/tools/pot-to-php.js" "$@"
fi
