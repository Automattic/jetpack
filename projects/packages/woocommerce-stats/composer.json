{
	"name": "automattic/jetpack-woocommerce-stats",
	"description": "WooCommerce: the WooCommerce section of the Premium Analytics dashboard.",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"automattic/jetpack-premium-analytics": "@dev"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^4.0.0",
		"automattic/jetpack-test-environment": "@dev",
		"automattic/phpunit-select-config": "@dev"
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"scripts": {
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-php": [
			"@composer phpunit"
		],
		"test-php-coverage": [
			"php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\""
		]
	},
	"repositories": [
		{
			"type": "path",
			"url": "../*",
			"options": {
				"monorepo": true
			}
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autorelease": true,
		"autotagger": true,
		"mirror-repo": "Automattic/jetpack-woocommerce-stats",
		"branch-alias": {
			"dev-trunk": "0.1.x-dev"
		},
		"textdomain": "jetpack-woocommerce-stats-pkg",
		"version-constants": {
			"::PACKAGE_VERSION": "src/class-analytics-dashboard.php"
		},
		"changelogger": {
			"link-template": "https://github.com/Automattic/jetpack-woocommerce-stats/compare/v${old}...v${new}"
		}
	},
	"config": {
		"allow-plugins": {
			"roots/wordpress-core-installer": true
		}
	}
}
