{
	"name": "@automattic/jetpack-woocommerce-stats",
	"version": "0.3.1",
	"private": true,
	"description": "WooCommerce: the WooCommerce section of the Premium Analytics dashboard.",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/packages/woocommerce-stats/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[Package] Woocommerce Stats"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/packages/woocommerce-stats"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"type": "module",
	"scripts": {
		"build": "pnpm run clean && pnpm run build:wp-build && pnpm run build:stamp-textdomains && pnpm run build:widget-strings",
		"build:stamp-textdomains": "stamp-textdomains",
		"build:strip-unminified-prod": "strip-unminified-prod",
		"build:widget-strings": "emit-widget-strings --schema ../premium-analytics/src/widget-i18n.json",
		"build:wp-build": "wp-build",
		"build-production": "NODE_ENV=production BABEL_ENV=production pnpm run build && pnpm run build:strip-unminified-prod",
		"clean": "rm -rf build/",
		"test": "jest",
		"test-coverage": "pnpm run test --coverage",
		"typecheck": "tsgo --noEmit",
		"watch": "wp-build --watch"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"dependencies": {
		"@automattic/jetpack-premium-analytics-sdk": "workspace:*",
		"@wordpress/api-fetch": "8.0.0",
		"@wordpress/date": "6.0.0",
		"@wordpress/hooks": "5.0.0",
		"@wordpress/i18n": "7.0.0",
		"@wordpress/url": "5.0.0",
		"@wordpress/widget-primitives": "0.10.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.7",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/jest": "30.0.0",
		"@types/react": "19.3.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@wordpress/browserslist-config": "7.0.0",
		"@wordpress/build": "0.26.0",
		"jest": "30.5.2",
		"typescript": "6.0.3"
	},
	"wpPlugin": {
		"name": "jetpack_woocommerce_stats",
		"packageNamespace": "jetpack-woocommerce-stats",
		"handlePrefix": "jetpack-woocommerce-stats",
		"externalNamespaces": {
			"automattic": {
				"global": "automattic",
				"handlePrefix": "automattic"
			}
		}
	}
}
