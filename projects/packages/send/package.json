{
	"name": "@automattic/jetpack-send",
	"version": "0.1.0-alpha",
	"private": true,
	"description": "Transactional email for Jetpack sites, delivered through MailChannels.",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/packages/send/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[Package] Send"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/packages/send"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"scripts": {
		"build": "pnpm run clean && pnpm run build:wp-build && pnpm run build:stamp-textdomains && pnpm run build:boot-asset",
		"build:boot-asset": "provide-boot-asset-file",
		"build:stamp-textdomains": "stamp-textdomains",
		"build:strip-unminified-prod": "strip-unminified-prod",
		"build:wp-build": "wp-build",
		"build-production": "NODE_ENV=production BABEL_ENV=production pnpm run build && pnpm run build:strip-unminified-prod && pnpm run validate",
		"clean": "rm -rf build/",
		"typecheck": "tsgo --noEmit",
		"validate": "pnpm exec validate-es --no-error-on-unmatched-pattern build/",
		"watch": "wp-build --watch"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"wpPlugin": {
		"name": "jetpack_send",
		"scriptGlobal": "jetpackSend",
		"packageNamespace": "jetpack-send",
		"handlePrefix": "jetpack-send",
		"pages": [
			{
				"id": "jetpack-send-dashboard",
				"init": [
					"@jetpack-send/init"
				]
			}
		]
	},
	"dependencies": {
		"@automattic/jetpack-base-styles": "workspace:*",
		"@automattic/jetpack-components": "workspace:*",
		"@automattic/jetpack-script-data": "workspace:*",
		"@jetpack-send/init": "link:packages/init",
		"@wordpress/api-fetch": "7.57.0",
		"@wordpress/components": "42.0.0",
		"@wordpress/data": "10.57.0",
		"@wordpress/dataviews": "20.0.0",
		"@wordpress/element": "9.0.0",
		"@wordpress/i18n": "6.30.0",
		"@wordpress/icons": "18.0.0",
		"@wordpress/preferences": "4.57.0",
		"@wordpress/route": "0.23.0",
		"@wordpress/ui": "0.24.0",
		"@wordpress/url": "4.57.0",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.7",
		"@types/react": "18.3.31",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@wordpress/base-styles": "13.3.0",
		"@wordpress/browserslist-config": "6.57.0",
		"@wordpress/build": "0.25.0",
		"@wordpress/theme": "2.3.0",
		"browserslist": "^4.24.0",
		"sass-embedded": "1.97.3"
	}
}
