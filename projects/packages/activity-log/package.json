{
	"private": true,
	"description": "Activity Log UI for the Jetpack plugin in wp-admin.",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/packages/activity-log/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[Package] Activity Log"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/packages/activity-log"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"scripts": {
		"build": "pnpm run clean && pnpm run build:wp-build && pnpm run build:stamp-textdomains && pnpm run build:boot-asset",
		"build:boot-asset": "provide-boot-asset-file",
		"build:stamp-textdomains": "stamp-textdomains",
		"build:strip-unminified-prod": "strip-unminified-prod",
		"build:wp-build": "wp-build",
		"build-production": "NODE_ENV=production BABEL_ENV=production pnpm run build && pnpm run build:strip-unminified-prod && pnpm run validate",
		"clean": "rm -rf build/",
		"test": "jest --config=tests/jest.config.js",
		"test-coverage": "pnpm run test --coverage",
		"typecheck": "tsgo --noEmit",
		"validate": "pnpm exec validate-es --no-error-on-unmatched-pattern build/",
		"watch": "wp-build --watch"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"wpPlugin": {
		"name": "jetpack_activity_log",
		"scriptGlobal": "jetpackActivityLog",
		"packageNamespace": "jetpack-activity-log",
		"handlePrefix": "jetpack-activity-log",
		"pages": [
			{
				"id": "jetpack-activity-log-dashboard",
				"init": [
					"@jetpack-activity-log/init"
				]
			}
		]
	},
	"dependencies": {
		"@automattic/jetpack-analytics": "workspace:*",
		"@automattic/jetpack-components": "workspace:*",
		"@automattic/jetpack-connection": "workspace:*",
		"@date-fns/tz": "1.5.0",
		"@jetpack-activity-log/init": "link:packages/init",
		"@tanstack/react-query": "^5.90.8",
		"@wordpress/admin-ui": "3.0.0",
		"@wordpress/api-fetch": "8.0.0",
		"@wordpress/base-styles": "14.0.0",
		"@wordpress/components": "43.0.0",
		"@wordpress/compose": "9.0.0",
		"@wordpress/data": "11.0.0",
		"@wordpress/dataviews": "21.0.0",
		"@wordpress/date": "6.0.0",
		"@wordpress/element": "10.0.0",
		"@wordpress/i18n": "7.0.0",
		"@wordpress/icons": "19.0.0",
		"@wordpress/primitives": "5.0.0",
		"@wordpress/route": "0.24.0",
		"@wordpress/ui": "0.25.0",
		"@wordpress/url": "5.0.0",
		"date-fns": "4.4.0",
		"fast-deep-equal": "3.1.3",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@automattic/jetpack-base-styles": "workspace:*",
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.7",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/react": "19.3.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@wordpress/browserslist-config": "7.0.0",
		"@wordpress/build": "0.26.0",
		"@wordpress/theme": "3.0.0",
		"babel-jest": "30.5.2",
		"browserslist": "^4.24.0",
		"jest": "30.5.2"
	}
}
