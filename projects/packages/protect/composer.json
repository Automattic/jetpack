{
	"name": "automattic/jetpack-protect",
	"description": "Shared Protect code for the Jetpack and Jetpack Protect plugins.",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"repositories": [
		{
			"type": "path",
			"url": "../../packages/*",
			"options": {
				"monorepo": true
			}
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autotagger": true,
		"branch-alias": {
			"dev-trunk": "0.1.x-dev"
		},
		"changelogger": {
			"link-template": "https://github.com/Automattic/jetpack-protect/compare/v${old}...v${new}"
		},
		"mirror-repo": "Automattic/jetpack-protect",
		"textdomain": "jetpack-protect-pkg",
		"version-constants": {
			"::PACKAGE_VERSION": "src/class-package.php"
		}
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	}
}
