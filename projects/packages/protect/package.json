{
	"name": "@automattic/jetpack-protect",
	"version": "0.1.0-alpha",
	"private": true,
	"description": "Shared Protect code for the Jetpack and Jetpack Protect plugins.",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/packages/protect/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[Package] Protect"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/packages/protect"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"scripts": {
		"build": "pnpm run clean && pnpm run build:wp-build && pnpm run build:stamp-textdomains && pnpm run build:boot-asset",
		"build:boot-asset": "provide-boot-asset-file",
		"build:stamp-textdomains": "stamp-textdomains",
		"build:strip-unminified-prod": "strip-unminified-prod",
		"build:wp-build": "wp-build",
		"build-production": "NODE_ENV=production BABEL_ENV=production pnpm run build && pnpm run build:strip-unminified-prod && pnpm run validate",
		"clean": "rm -rf build/",
		"typecheck": "tsgo --noEmit",
		"validate": "pnpm exec validate-es --no-error-on-unmatched-pattern build/",
		"watch": "wp-build --watch"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"wpPlugin": {
		"name": "jetpack_protect",
		"scriptGlobal": "jetpackProtect",
		"packageNamespace": "jetpack-protect",
		"handlePrefix": "jetpack-protect",
		"pages": [
			{
				"id": "jetpack-protect-dashboard",
				"init": [
					"@jetpack-protect/init"
				]
			}
		]
	},
	"dependencies": {
		"@jetpack-protect/init": "link:packages/init",
		"@wordpress/admin-ui": "2.10.0",
		"@wordpress/element": "8.7.0",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.7",
		"@types/react": "18.3.31",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@wordpress/browserslist-config": "6.55.0",
		"@wordpress/build": "0.23.0",
		"browserslist": "^4.24.0"
	}
}
