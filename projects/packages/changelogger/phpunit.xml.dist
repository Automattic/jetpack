<?xml version="1.0"?>
<phpunit bootstrap="tests/php/bootstrap.php" backupGlobals="true" colors="true" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="main">
      <directory suffix=".php">tests/php/tests</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">lib</directory>
      <directory suffix=".php">src</directory>
    </include>
  </source>
</phpunit>
