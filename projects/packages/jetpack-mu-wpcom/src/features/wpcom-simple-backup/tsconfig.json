{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "jetpack-js-tools/tsconfig.base.json",
	"compilerOptions": {
		"lib": [ "ES2022", "DOM", "DOM.Iterable" ],
		// The shared base leaves `strict` off, and with it `strictNullChecks`. The
		// `getInitialState()` fallback relies on `??` narrowing an optional global,
		// which only reports correctly with it on.
		"strictNullChecks": true
	},
	"include": [ "js/**/*" ]
}
