{
	"name": "@automattic/jetpack-my-jetpack",
	"version": "6.2.1",
	"private": true,
	"description": "WP Admin page with information and configuration shared among all Jetpack stand-alone plugins",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/packages/my-jetpack/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[Package] My Jetpack"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/packages/my-jetpack"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"type": "module",
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"exports": {
		"./components/*": "./_inc/components/*"
	},
	"scripts": {
		"build": "pnpm run clean && concurrently 'pnpm:build-client' 'pnpm:build:wp-build' && pnpm run build:stamp-textdomains && pnpm run build:boot-asset && pnpm run build:copy-images",
		"build:boot-asset": "provide-boot-asset-file",
		"build:copy-images": "node bin/copy-raster-images.mjs",
		"build:stamp-textdomains": "stamp-textdomains",
		"build:strip-unminified-prod": "strip-unminified-prod",
		"build:wp-build": "wp-build",
		"build-client": "pnpm webpack --config webpack.config.js",
		"build-production": "pnpm run clean && concurrently 'pnpm:build-production-client' 'pnpm:build:wp-build' && pnpm run build:stamp-textdomains && pnpm run build:strip-unminified-prod && pnpm run build:boot-asset && pnpm run build:copy-images && pnpm run validate",
		"build-production-client": "NODE_ENV=production BABEL_ENV=production pnpm run build-client",
		"clean": "rm -rf build/",
		"generate:inline-svgs": "node bin/generate-inline-svgs.mjs",
		"test": "jest --config=tests/jest.config.js",
		"test-coverage": "pnpm run test --coverage",
		"typecheck": "tsgo --noEmit",
		"validate": "pnpm exec validate-es build/",
		"watch": "pnpm run build:copy-images && concurrently 'pnpm:build-client --watch' 'pnpm:watch:wp-build'",
		"watch:hot": "pnpm run clean && webpack serve",
		"watch:wp-build": "wp-build --watch"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"dependencies": {
		"@automattic/babel-plugin-replace-textdomain": "workspace:*",
		"@automattic/charts": "workspace:*",
		"@automattic/jetpack-analytics": "workspace:*",
		"@automattic/jetpack-api": "workspace:*",
		"@automattic/jetpack-base-styles": "workspace:*",
		"@automattic/jetpack-boost-score-api": "workspace:*",
		"@automattic/jetpack-components": "workspace:*",
		"@automattic/jetpack-connection": "workspace:*",
		"@automattic/jetpack-explat": "workspace:*",
		"@automattic/jetpack-licensing": "workspace:*",
		"@automattic/jetpack-script-data": "workspace:*",
		"@automattic/jetpack-shared-extension-utils": "workspace:*",
		"@automattic/jetpack-shared-stores": "workspace:*",
		"@automattic/number-formatters": "workspace:*",
		"@jetpack-my-jetpack/init": "link:packages/init",
		"@tanstack/react-query": "5.102.8",
		"@wordpress/admin-ui": "2.9.0",
		"@wordpress/api-fetch": "7.54.0",
		"@wordpress/base-styles": "13.0.0",
		"@wordpress/components": "40.0.0",
		"@wordpress/compose": "8.7.0",
		"@wordpress/data": "10.54.0",
		"@wordpress/dataviews": "18.1.0",
		"@wordpress/date": "5.54.0",
		"@wordpress/element": "8.6.0",
		"@wordpress/i18n": "6.27.0",
		"@wordpress/icons": "15.5.0",
		"@wordpress/route": "0.20.0",
		"@wordpress/theme": "2.0.0",
		"@wordpress/ui": "0.21.0",
		"@wordpress/url": "4.54.0",
		"clsx": "2.1.1",
		"debug": "4.4.3",
		"gridicons": "3.4.3",
		"prop-types": "15.8.1",
		"react-router": "7.18.2"
	},
	"devDependencies": {
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.7",
		"@storybook/addon-docs": "10.4.6",
		"@storybook/react": "10.4.6",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/jest": "30.0.0",
		"@types/node": "^24.12.0",
		"@types/react": "18.3.31",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@wordpress/browserslist-config": "6.54.0",
		"@wordpress/build": "0.22.0",
		"autoprefixer": "10.4.20",
		"browserslist": "^4.24.0",
		"concurrently": "10.0.5",
		"jest": "30.4.2",
		"postcss": "8.5.23",
		"postcss-loader": "8.2.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"require-from-string": "2.0.2",
		"sass-embedded": "1.97.3",
		"sass-loader": "16.0.5",
		"storybook": "10.4.6",
		"typescript": "6.0.3",
		"webpack": "5.107.2",
		"webpack-cli": "7.2.1",
		"webpack-dev-server": "6.0.0"
	},
	"wpPlugin": {
		"name": "jetpack_my_jetpack",
		"scriptGlobal": "jetpackMyJetpack",
		"packageNamespace": "jetpack-my-jetpack",
		"handlePrefix": "jetpack-my-jetpack",
		"pages": [
			{
				"id": "my-jetpack-dashboard",
				"init": [
					"@jetpack-my-jetpack/init"
				]
			}
		]
	}
}
