{
	"extends": "jetpack-js-tools/tsconfig.base.json",
	// List all sources and source-containing subdirs.
	"include": [
		"./src/client",
		"./src/dashboard",
		"routes/**/*",
		"widgets/**/*",
		"./declarations.d.ts",
		"./wordpress-augmentations.d.ts"
	],
	// Overriding `files` drops the base list, so re-add the console matcher types tests rely on.
	"files": [ "./global.d.ts", "../../../tools/js-tools/jest/setup-console.d.ts" ]
}
