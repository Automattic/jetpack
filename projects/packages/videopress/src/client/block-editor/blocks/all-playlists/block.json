{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "videopress/all-playlists",
	"version": "0.1.0",
	"title": "All Playlists",
	"category": "media",
	"icon": "<svg viewBox='0 0 24 24' width='24' height='24' xmlns='http://www.w3.org/2000/svg'><path fill-rule='evenodd' clip-rule='evenodd' d='M4 5.5h9A1.5 1.5 0 0 1 14.5 7v6A1.5 1.5 0 0 1 13 14.5H4A1.5 1.5 0 0 1 2.5 13V7A1.5 1.5 0 0 1 4 5.5Zm3.5 2.6v3.8L10.7 10 7.5 8.1ZM16.5 7H21v1.5h-4.5V7Zm0 4H21v1.5h-4.5V11Zm-14 6H21v1.5H2.5V17Z'></path></svg>",
	"description": "Every playlist on the site, paginated, under a heading you can edit.",
	"keywords": [ "playlist", "playlists", "video", "videopress", "collection", "gallery" ],
	"textdomain": "jetpack-videopress-pkg",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"anchor": true,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"text": true,
			"background": true,
			"gradients": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		}
	},
	"attributes": {
		"layout": {
			"type": "string",
			"enum": [ "gallery", "list" ],
			"default": "gallery"
		},
		"columns": {
			"type": "integer",
			"default": 3
		},
		"perPage": {
			"type": "integer",
			"default": 6
		},
		"orderBy": {
			"type": "string",
			"enum": [ "newest", "oldest", "title" ],
			"default": "newest"
		},
		"showDescription": {
			"type": "boolean",
			"default": true
		},
		"showVideoCount": {
			"type": "boolean",
			"default": true
		},
		"pagination": {
			"type": "string",
			"enum": [ "numbered", "load-more" ],
			"default": "numbered"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": [ "file:./index.css", "file:./view.css" ],
	"viewScript": "file:./view.js",
	"viewStyle": "file:./view.css"
}
