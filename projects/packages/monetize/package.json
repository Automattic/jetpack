{
	"name": "@automattic/jetpack-monetize",
	"version": "0.1.0",
	"private": true,
	"description": "The Monetize dashboard: payments, paid subscribers and ads in wp-admin.",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/packages/monetize/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[Package] Monetize"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/packages/monetize"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"scripts": {
		"build": "pnpm run clean && pnpm run build:wp-build && pnpm run build:stamp-textdomains && pnpm run build:boot-asset",
		"build:boot-asset": "provide-boot-asset-file",
		"build:stamp-textdomains": "stamp-textdomains",
		"build:strip-unminified-prod": "strip-unminified-prod",
		"build:wp-build": "wp-build",
		"build-production": "NODE_ENV=production BABEL_ENV=production pnpm run build && pnpm run build:strip-unminified-prod && pnpm run validate",
		"clean": "rm -rf build/",
		"test": "jest --config=tests/jest.config.js",
		"test-coverage": "pnpm run test --coverage",
		"typecheck": "tsgo --noEmit",
		"validate": "pnpm exec validate-es --no-error-on-unmatched-pattern build/",
		"watch": "wp-build --watch"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"wpPlugin": {
		"name": "jetpack_monetize",
		"scriptGlobal": "jetpackMonetize",
		"packageNamespace": "jetpack-monetize",
		"handlePrefix": "jetpack-monetize",
		"pages": [
			{
				"id": "jetpack-monetize-dashboard",
				"init": [
					"@jetpack-monetize/init"
				]
			}
		]
	},
	"dependencies": {
		"@automattic/jetpack-base-styles": "workspace:*",
		"@automattic/jetpack-components": "workspace:*",
		"@jetpack-monetize/init": "link:packages/init",
		"@wordpress/element": "10.1.0",
		"@wordpress/i18n": "7.1.0",
		"@wordpress/route": "0.25.0",
		"@wordpress/ui": "0.26.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.7",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/jest": "30.0.0",
		"@types/react": "19.3.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@wordpress/browserslist-config": "7.1.0",
		"@wordpress/build": "0.27.0",
		"browserslist": "^4.24.0",
		"jest": "30.5.2"
	}
}
