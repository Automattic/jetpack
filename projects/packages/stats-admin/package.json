{
	"name": "@automattic/jetpack-stats-admin",
	"version": "0.31.4",
	"private": true,
	"description": "Stats Dashboard",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/packages/stats-admin/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[Package] Stats Admin"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/packages/stats-admin"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"type": "module",
	"scripts": {
		"build": "pnpm run clean && pnpm run build:wp-build",
		"build:wp-build": "BROWSERSLIST='defaults and supports es6-module' wp-build",
		"build-production": "NODE_ENV=production BABEL_ENV=production pnpm run build",
		"clean": "rm -rf build/ .cache/",
		"watch": "pnpm run watch:wp-build",
		"watch:wp-build": "BROWSERSLIST='defaults and supports es6-module' wp-build --watch"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"dependencies": {
		"@automattic/charts": "workspace:*",
		"@automattic/jetpack-shared-extension-utils": "workspace:*",
		"@automattic/number-formatters": "workspace:*",
		"@tanstack/react-query": "5.90.8",
		"@wordpress/api-fetch": "7.46.0",
		"@wordpress/element": "6.46.0",
		"@wordpress/i18n": "6.19.0",
		"@wordpress/icons": "12.2.0",
		"@wordpress/ui": "0.13.0",
		"clsx": "2.1.1"
	},
	"devDependencies": {
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.0",
		"@types/react": "18.3.28",
		"@wordpress/browserslist-config": "6.46.0",
		"@wordpress/build": "0.13.2-next.v.202605131032.0",
		"browserslist": "^4.24.0",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"wpPlugin": {
		"name": "jetpack_stats_admin",
		"scriptGlobal": "jetpackStatsAdmin",
		"packageNamespace": "jetpack-stats-admin",
		"handlePrefix": "jetpack-stats-admin"
	}
}
