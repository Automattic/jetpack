{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jetpack/paypal-payment-buttons",
	"version": "0.8.0",
	"title": "PayPal Payment Buttons",
	"category": "monetize",
	"icon": "<svg viewBox='0 0 24 24' width='24' height='24' xmlns='http://www.w3.org/2000/svg'><path fill='none' d='M0 0h24v24H0V0z' /><path d='M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z' /></svg>",
	"description": "Accept payments with PayPal Payment Buttons.",
	"example": {},
	"attributes": {
		"isApiManaged": {
			"type": "boolean",
			"default": false
		},
		"buttonType": {
			"type": "string",
			"enum": [ "stacked", "single" ],
			"default": "stacked"
		},
		"scriptSrc": {
			"type": "string"
		},
		"hostedButtonId": {
			"type": "string"
		},
		"buttonText": {
			"type": "string",
			"default": "Pay Now"
		},
		"resourceId": {
			"type": "string"
		},
		"paymentLink": {
			"type": "string"
		},
		"productName": {
			"type": "string"
		},
		"price": {
			"type": "string"
		},
		"currencyCode": {
			"type": "string",
			"default": "USD"
		},
		"productDescription": {
			"type": "string"
		},
		"imageUrl": {
			"type": "string"
		},
		"returnUrl": {
			"type": "string"
		},
		"variantsEnabled": {
			"type": "boolean",
			"default": false
		},
		"variants": {
			"type": "object",
			"default": null
		},
		"adjustableQuantity": {
			"type": "boolean",
			"default": false
		},
		"maxQuantity": {
			"type": "number",
			"default": 10
		},
		"customerNotes": {
			"type": "array",
			"default": []
		},
		"taxEnabled": {
			"type": "boolean",
			"default": false
		},
		"taxType": {
			"type": "string",
			"default": "PERCENTAGE"
		},
		"taxName": {
			"type": "string",
			"default": "Sales Tax"
		},
		"taxValue": {
			"type": "string",
			"default": ""
		},
		"collectShippingAddress": {
			"type": "boolean",
			"default": false
		},
		"shippingEnabled": {
			"type": "boolean",
			"default": false
		},
		"shippingType": {
			"type": "string",
			"default": "FLAT"
		},
		"shippingValue": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "jetpack-paypal-payments",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css"
}
