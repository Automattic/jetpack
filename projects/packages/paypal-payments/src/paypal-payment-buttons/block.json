{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jetpack/paypal-payment-buttons",
	"title": "PayPal Payment Buttons",
	"description": "Accept payments via PayPal. Create a buy button directly in the editor \u2014 no code required.",
	"keywords": [ "paypal", "payment", "buy", "sell", "commerce", "checkout" ],
	"category": "monetize",
	"icon": "<svg viewBox='0 0 24 24' width='24' height='24' xmlns='http://www.w3.org/2000/svg'><path fill-rule='evenodd' clip-rule='evenodd' d='M5.5 9.5v-2h13v2h-13zm0 3v4h13v-4h-13zM4 7a1 1 0 011-1h14a1 1 0 011 1v10a1 1 0 01-1 1H5a1 1 0 01-1-1V7z'/></svg>",
	"example": {},
	"textdomain": "jetpack-paypal-payments",
	"supports": {
		"html": false,
		"multiple": true,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"isApiManaged": {
			"type": "boolean",
			"default": false
		},
		"resourceId": {
			"type": "string",
			"default": ""
		},
		"paymentLink": {
			"type": "string",
			"default": ""
		},
		"productName": {
			"type": "string",
			"default": ""
		},
		"price": {
			"type": "string",
			"default": ""
		},
		"currencyCode": {
			"type": "string",
			"default": "USD"
		},
		"productDescription": {
			"type": "string",
			"default": ""
		},
		"imageUrl": {
			"type": "string"
		},
		"imageId": {
			"type": "number"
		},
		"buttonText": {
			"type": "string",
			"default": ""
		},
		"buttonType": {
			"type": "string",
			"enum": [ "stacked", "single" ],
			"default": "stacked"
		},
		"scriptSrc": {
			"type": "string",
			"default": ""
		},
		"hostedButtonId": {
			"type": "string",
			"default": ""
		},
		"returnUrl": {
			"type": "string",
			"default": ""
		},
		"variantsEnabled": {
			"type": "boolean",
			"default": false
		},
		"variants": {
			"type": "object",
			"default": null
		},
		"adjustableQuantity": {
			"type": "boolean",
			"default": false
		},
		"maxQuantity": {
			"type": "number",
			"default": 10
		},
		"customerNotes": {
			"type": "array",
			"default": []
		},
		"taxEnabled": {
			"type": "boolean",
			"default": false
		},
		"taxType": {
			"type": "string",
			"default": "PERCENTAGE"
		},
		"taxName": {
			"type": "string",
			"default": "Sales Tax"
		},
		"taxValue": {
			"type": "string",
			"default": ""
		},
		"collectShippingAddress": {
			"type": "boolean",
			"default": true
		},
		"shippingEnabled": {
			"type": "boolean",
			"default": false
		},
		"shippingType": {
			"type": "string",
			"default": "FLAT"
		},
		"shippingValue": {
			"type": "string",
			"default": ""
		},
		"format": {
			"type": "string",
			"enum": [ "BUTTON", "LINK", "QR" ],
			"default": "BUTTON"
		},
		"buttonShowPoweredBy": {
			"type": "boolean",
			"default": false
		},
		"buttonStyle": {
			"type": "string",
			"enum": [ "fill", "outline" ],
			"default": "fill"
		},
		"buttonTextColor": {
			"type": "string",
			"default": ""
		},
		"buttonBackgroundColor": {
			"type": "string",
			"default": ""
		},
		"buttonFontSize": {
			"type": "string",
			"default": ""
		},
		"qrShowCaption": {
			"type": "boolean",
			"default": false
		},
		"qrCaption": {
			"type": "string",
			"default": ""
		},
		"captionColor": {
			"type": "string",
			"default": ""
		},
		"captionFontSize": {
			"type": "string",
			"default": ""
		},
		"linkText": {
			"type": "string",
			"default": ""
		},
		"linkColor": {
			"type": "string",
			"default": ""
		},
		"linkFontSize": {
			"type": "string",
			"default": ""
		},
		"blockWidth": {
			"type": "string",
			"default": ""
		},
		"style": {
			"type": "object"
		}
	}
}
