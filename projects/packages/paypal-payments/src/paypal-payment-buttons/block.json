{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jetpack/paypal-payment-buttons",
	"title": "PayPal Payment Buttons",
	"description": "Accept payments via PayPal. Create a buy button directly in the editor \u2014 no code required.",
	"keywords": [ "paypal", "payment", "buy", "sell", "commerce", "checkout" ],
	"category": "earn",
	"icon": "paypal",
	"textdomain": "jetpack-paypal-payments",
	"supports": {
		"html": false,
		"multiple": true,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"isApiManaged": {
			"type": "boolean",
			"default": false
		},
		"resourceId": {
			"type": "string",
			"default": ""
		},
		"paymentLink": {
			"type": "string",
			"default": ""
		},
		"productName": {
			"type": "string",
			"default": ""
		},
		"price": {
			"type": "string",
			"default": ""
		},
		"currencyCode": {
			"type": "string",
			"default": "USD"
		},
		"productDescription": {
			"type": "string",
			"default": ""
		},
		"imageUrl": {
			"type": "string"
		},
		"imageId": {
			"type": "number"
		},
		"buttonText": {
			"type": "string",
			"default": "Buy Now"
		},
		"buttonType": {
			"type": "string",
			"enum": [ "stacked", "single" ],
			"default": "single"
		},
		"scriptSrc": {
			"type": "string",
			"default": ""
		},
		"hostedButtonId": {
			"type": "string",
			"default": ""
		},
		"returnUrl": {
			"type": "string",
			"default": ""
		},
		"variantsEnabled": {
			"type": "boolean",
			"default": false
		},
		"variants": {
			"type": "object",
			"default": null
		},
		"adjustableQuantity": {
			"type": "boolean",
			"default": false
		},
		"maxQuantity": {
			"type": "number",
			"default": 10
		},
		"customerNotes": {
			"type": "array",
			"default": []
		},
		"taxEnabled": {
			"type": "boolean",
			"default": false
		},
		"taxType": {
			"type": "string",
			"default": "PERCENTAGE"
		},
		"taxName": {
			"type": "string",
			"default": "Sales Tax"
		},
		"taxValue": {
			"type": "string",
			"default": ""
		},
		"collectShippingAddress": {
			"type": "boolean",
			"default": false
		},
		"shippingEnabled": {
			"type": "boolean",
			"default": false
		},
		"shippingType": {
			"type": "string",
			"default": "FLAT"
		},
		"shippingValue": {
			"type": "string",
			"default": ""
		},
		"showQrCode": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "file:../../dist/paypal-payment-buttons/editor.js",
	"editorStyle": "file:../../dist/paypal-payment-buttons/editor.css",
	"style": "file:../../dist/paypal-payment-buttons/style.css"
}
