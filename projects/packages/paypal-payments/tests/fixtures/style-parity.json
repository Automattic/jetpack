{
	"_comment": "Attribute sets and the CSS each side must produce. Read by tests/js/block-styles.test.js and tests/php/Paypal_Payment_Buttons_Test.php so a value one language drops fails a test in the other. The premise of WOOPTP-491 is that the canvas and the published page agree; this is the file that enforces it.",
	"cases": [
		{
			"name": "a spacing preset",
			"attributes": { "style": { "spacing": { "margin": { "top": "var:preset|spacing|50" } } } },
			"declarations": { "margin-top": "var(--wp--preset--spacing--50)" }
		},
		{
			"name": "zero margin cancels the stylesheet",
			"attributes": { "style": { "spacing": { "margin": { "top": "0", "bottom": "0" } } } },
			"declarations": { "margin-top": "0", "margin-bottom": "0" }
		},
		{
			"name": "one axis only, the other left to the stylesheet",
			"attributes": { "style": { "spacing": { "margin": { "left": "8px", "right": "8px" } } } },
			"declarations": { "margin-left": "8px", "margin-right": "8px" }
		},
		{
			"name": "a full stroke",
			"attributes": { "style": { "border": { "width": "2px", "color": "#ff0000" } } },
			"declarations": { "border-width": "2px", "border-color": "#ff0000", "border-style": "solid" }
		},
		{
			"name": "a half stroke draws nothing",
			"attributes": { "style": { "border": { "width": "2px" } } },
			"declarations": {}
		},
		{
			"name": "a radius per corner",
			"attributes": {
				"style": { "border": { "radius": { "topLeft": "4px", "bottomRight": "9px" } } }
			},
			"declarations": { "border-top-left-radius": "4px", "border-bottom-right-radius": "9px" }
		},
		{
			"name": "width with its unit",
			"attributes": { "blockWidth": "75%" },
			"declarations": { "max-width": "75%" }
		}
	],
	"captionCases": [
		{
			"name": "a size with its unit",
			"attributes": { "captionFontSize": "1.5rem" },
			"declarations": { "font-size": "1.5rem" }
		},
		{
			"name": "a theme preset size",
			"attributes": { "captionFontSize": "var(--wp--preset--font-size--small)" },
			"declarations": { "font-size": "var(--wp--preset--font-size--small)" }
		},
		{
			"name": "a colour",
			"attributes": { "captionColor": "#0000ff" },
			"declarations": { "color": "#0000ff" }
		}
	]
}
