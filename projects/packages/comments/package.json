{
	"name": "@automattic/jetpack-comments",
	"version": "0.4.0",
	"private": true,
	"description": "Replaces the default WordPress comment form.",
	"homepage": "https://github.com/Automattic/jetpack/tree/HEAD/projects/packages/comments/#readme",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[Package] Comments"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/packages/comments"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"type": "module",
	"scripts": {
		"build": "pnpm run clean && concurrently 'pnpm:build-js' 'pnpm:build:wp-build' && pnpm run build:stamp-textdomains && pnpm run build:boot-asset",
		"build:boot-asset": "provide-boot-asset-file",
		"build:stamp-textdomains": "stamp-textdomains",
		"build:strip-unminified-prod": "strip-unminified-prod",
		"build:wp-build": "wp-build",
		"build-js": "webpack --config webpack.config.js",
		"build-production": "pnpm run clean && concurrently 'pnpm:build-production-js' 'pnpm:build:wp-build' && pnpm run build:stamp-textdomains && pnpm run build:strip-unminified-prod && pnpm run build:boot-asset && pnpm run validate",
		"build-production-js": "NODE_ENV=production BABEL_ENV=production pnpm run build-js",
		"clean": "rm -rf build/",
		"typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.settings.json",
		"validate": "pnpm exec validate-es --no-error-on-unmatched-pattern build/",
		"watch": "concurrently 'pnpm:build-js --watch' 'pnpm:watch:wp-build'",
		"watch:wp-build": "wp-build --watch"
	},
	"dependencies": {
		"@automattic/jetpack-base-styles": "workspace:*",
		"@automattic/jetpack-components": "workspace:*",
		"@automattic/jetpack-script-data": "workspace:*",
		"@jetpack-comments/init": "link:packages/init",
		"@preact/signals": "1.2.2",
		"@wordpress/api-fetch": "7.55.0",
		"@wordpress/block-editor": "17.1.0",
		"@wordpress/block-library": "11.0.0",
		"@wordpress/blocks": "16.0.0",
		"@wordpress/components": "40.1.0",
		"@wordpress/data": "10.55.0",
		"@wordpress/dataviews": "19.0.0",
		"@wordpress/element": "8.7.0",
		"@wordpress/format-library": "5.55.0",
		"@wordpress/i18n": "6.28.0",
		"@wordpress/icons": "16.0.0",
		"@wordpress/notices": "5.55.0",
		"@wordpress/rich-text": "7.55.0",
		"@wordpress/route": "0.21.0",
		"@wordpress/theme": "2.1.0",
		"@wordpress/ui": "0.22.0",
		"clsx": "2.1.1",
		"preact": "10.28.2",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.7",
		"@babel/plugin-transform-react-jsx": "7.29.7",
		"@babel/runtime": "7.29.7",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@wordpress/base-styles": "13.1.0",
		"@wordpress/browserslist-config": "6.55.0",
		"@wordpress/build": "0.23.0",
		"autoprefixer": "10.4.20",
		"babel-plugin-transform-rename-properties": "0.1.0",
		"browserslist": "^4.24.0",
		"concurrently": "10.0.5",
		"postcss": "8.5.23",
		"postcss-loader": "8.2.0",
		"sass-embedded": "1.97.3",
		"sass-loader": "16.0.5",
		"webpack": "5.111.1",
		"webpack-cli": "7.2.1"
	},
	"wpPlugin": {
		"name": "jetpack_comments",
		"scriptGlobal": "jetpackComments",
		"packageNamespace": "jetpack-comments",
		"handlePrefix": "jetpack-comments",
		"pages": [
			{
				"id": "jetpack-comments-settings",
				"init": [
					"@jetpack-comments/init"
				]
			}
		]
	}
}
