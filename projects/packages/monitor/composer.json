{
	"name": "automattic/jetpack-monitor",
	"description": "Downtime monitoring for connected sites: the module's email alerts and status from WordPress.com.",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"automattic/jetpack-connection": "@dev"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^4.0.0",
		"automattic/jetpack-test-environment": "@dev",
		"automattic/phpunit-select-config": "@dev"
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Automattic\\Jetpack\\Monitor\\": "tests/php"
		}
	},
	"scripts": {
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-php": [
			"@composer phpunit"
		],
		"test-php-coverage": [
			"php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\""
		]
	},
	"repositories": [
		{
			"type": "path",
			"url": "../../packages/*",
			"options": {
				"monorepo": true
			}
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autotagger": true,
		"branch-alias": {
			"dev-trunk": "0.1.x-dev"
		},
		"changelogger": {
			"link-template": "https://github.com/Automattic/jetpack-monitor/compare/v${old}...v${new}"
		},
		"mirror-repo": "Automattic/jetpack-monitor",
		"textdomain": "jetpack-monitor",
		"version-constants": {
			"::PACKAGE_VERSION": "src/class-monitor.php"
		}
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	}
}
