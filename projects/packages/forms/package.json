	},
	"optionalDependencies": {
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"wpPlugin": {
		"scriptGlobal": "jetpackForms",
		"packageNamespace": "jetpack-forms",
		"handlePrefix": "jetpack-forms",
		"pages": [
			"jetpack-forms-responses"
		]
	}
}
