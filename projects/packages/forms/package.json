		"gridicons": "3.4.2",
		"js-sha256": "0.11.1",
		"libphonenumber-js": "1.12.34",
		"lodash": "4.17.21",
		"photon": "4.1.1",
		"react-redux": "7.2.8",
		"react-router": "7.12.0",
		"react-transition-group": "^4.4.5",
		"redux": "4.2.1",
		"redux-thunk": "2.3.0",
		"semver": "7.7.3",
		"webpack": "5.101.3",
		"webpack-cli": "6.0.1"
	},
	"devDependencies": {
