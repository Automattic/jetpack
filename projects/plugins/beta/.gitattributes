# Files to include in mirror repo: Automattic/vaultpress
# Remember to end all directories with `/**` to properly tag every file.
build/**                                    production-include
jetpack_vendor/**                           production-include
vendor/autoload.php                         production-include
vendor/autoload_packages.php                production-include
vendor/automattic/**                        production-include
vendor/composer/**                          production-include
vendor/composer/semver/**                   production-include
vendor/erusev/parsedown/**                  production-include
vendor/jetpack-autoloader/**                production-include

# Files not needed in the production build.
# (see also entries in the monorepo root .gitattributes)
# Remember to end all directories with `/**` to properly tag every file.
global.d.ts                                 production-exclude
routes/**                                   production-exclude
src/**/*.scss                               production-exclude
src/**/*.tsx                                production-exclude
src/**/*.ts                                 production-exclude
