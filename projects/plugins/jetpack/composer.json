{
	"name": "automattic/jetpack",
	"description": "Jetpack supercharges your self‑hosted WordPress site with the awesome cloud power of WordPress.com",
	"homepage": "https://jetpack.com/",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"support": {
		"issues": "https://github.com/Automattic/jetpack/issues"
	},
	"require": {
		"ext-fileinfo": "*",
		"ext-json": "*",
		"ext-openssl": "*",
		"automattic/block-delimiter": "^0.4.1",
		"automattic/jetpack-a8c-mc-stats": "^4.0.1",
		"automattic/jetpack-account-protection": "^0.4.2",
		"automattic/jetpack-activity-log": "^0.7.4",
		"automattic/jetpack-admin-ui": "^0.14.14",
		"automattic/jetpack-ads": "^0.1.8",
		"automattic/jetpack-agents-manager": "^0.12.11",
		"automattic/jetpack-assets": "^5.0.19",
		"automattic/jetpack-autoloader": "^6.0.3",
		"automattic/jetpack-backup": "^5.2.4",
		"automattic/jetpack-blaze": "^0.29.15",
		"automattic/jetpack-blocks": "^4.0.1",
		"automattic/jetpack-boost-speed-score": "^0.6.2",
		"automattic/jetpack-classic-theme-helper": "^0.15.12",
		"automattic/jetpack-comments": "^0.9.0",
		"automattic/jetpack-compat": "^5.0.1",
		"automattic/jetpack-composer-plugin": "^5.0.1",
		"automattic/jetpack-config": "^4.0.1",
		"automattic/jetpack-connection": "^9.17.2",
		"automattic/jetpack-constants": "^4.0.1",
		"automattic/jetpack-device-detection": "^4.0.1",
		"automattic/jetpack-error": "^4.0.1",
		"automattic/jetpack-external-connections": "^0.2.10",
		"automattic/jetpack-external-media": "^0.9.13",
		"automattic/jetpack-feature-flags": "^0.2.1",
		"automattic/jetpack-forms": "^8.3.8",
		"automattic/jetpack-image-cdn": "^0.8.5",
		"automattic/jetpack-import": "^0.10.1",
		"automattic/jetpack-ip": "^0.7.1",
		"automattic/jetpack-jitm": "^5.1.9",
		"automattic/jetpack-knowledge": "^0.1.1",
		"automattic/jetpack-licensing": "^4.1.1",
		"automattic/jetpack-logo": "^4.0.2",
		"automattic/jetpack-masterbar": "^0.30.3",
		"automattic/jetpack-menu-badges": "^0.2.3",
		"automattic/jetpack-monetize": "^0.1.0",
		"automattic/jetpack-monitor": "^0.1.0",
		"automattic/jetpack-my-jetpack": "^6.17.1",
		"automattic/jetpack-newsletter": "^0.18.5",
		"automattic/jetpack-paypal-payments": "^0.14.0",
		"automattic/jetpack-plugins-installer": "^0.6.1",
		"automattic/jetpack-podcast": "^2.2.6",
		"automattic/jetpack-post-list": "^0.10.11",
		"automattic/jetpack-post-media": "^0.3.3",
		"automattic/jetpack-premium-analytics": "^0.17.0",
		"automattic/jetpack-protect": "^0.6.0",
		"automattic/jetpack-publicize": "^0.88.10",
		"automattic/jetpack-redirect": "^4.0.1",
		"automattic/jetpack-roles": "^4.0.1",
		"automattic/jetpack-scan-page": "^0.2.14",
		"automattic/jetpack-search": "^8.4.2",
		"automattic/jetpack-seo": "^0.11.0",
		"automattic/jetpack-sharing-likes": "^0.6.1",
		"automattic/jetpack-stats": "^0.24.1",
		"automattic/jetpack-stats-admin": "^0.40.0",
		"automattic/jetpack-status": "^7.1.1",
		"automattic/jetpack-sync": "^5.5.1",
		"automattic/jetpack-videopress": "^0.62.0",
		"automattic/jetpack-waf": "^0.32.0",
		"automattic/jetpack-woocommerce-stats": "^0.3.3",
		"automattic/jetpack-wp-abilities": "^0.2.1",
		"automattic/jetpack-wp-build-polyfills": "^0.7.4",
		"automattic/woocommerce-analytics": "^0.18",
		"wp-php-toolkit/reprint-server": "0.11.2"
	},
	"require-dev": {
		"antecedent/patchwork": "^2.2",
		"automattic/patchwork-redefine-exit": "^3.0.1",
		"automattic/phpunit-select-config": "^1.0.12",
		"yoast/phpunit-polyfills": "^4.0.0"
	},
	"scripts": {
		"build-production": [
			"pnpm run build-production-concurrently"
		],
		"build-development": [
			"pnpm run build-concurrently"
		],
		"phpunit": [
			"tests/action-phpunit.sh"
		],
		"test-js": "tests/action-test-js.sh",
		"test-js-coverage": "tests/action-test-js.sh --coverage",
		"test-php": [
			"@php tools/build-module-headings-translations.php",
			"tests/action-test-php.sh"
		],
		"test-php-coverage": [
			"@php tools/build-module-headings-translations.php",
			"tests/action-test-php-coverage.sh"
		],
		"watch": [
			"Composer\\Config::disableProcessTimeout",
			"pnpm run watch"
		]
	},
	"repositories": [],
	"autoload": {
		"classmap": [
			"src"
		]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"sort-packages": true,
		"platform": {
			"ext-intl": "0.0.0"
		},
		"autoloader-suffix": "f11009ded9fc4592b6a05b61ce272b3c_jetpackⓥ16_5_a_1",
		"allow-plugins": {
			"automattic/jetpack-autoloader": true,
			"automattic/jetpack-composer-plugin": true
		}
	},
	"extra": {
		"autotagger": {
			"v": false
		},
		"autorelease": {
			"titlefmt": "Jetpack %s"
		},
		"wp-svn-autopublish": true,
		"mirror-repo": "Automattic/jetpack-production",
		"release-branch-prefix": [
			"jetpack",
			"weekly",
			"monthly"
		],
		"version-constants": {
			"JETPACK__VERSION": "jetpack.php"
		},
		"wp-plugin-slug": "jetpack",
		"dev-releases": true,
		"changelogger-default-type": "other",
		"changelogger": {
			"versioning": "wordpress",
			"types": {
				"major": "Major Enhancements",
				"enhancement": "Enhancements",
				"compat": "Improved compatibility",
				"bugfix": "Bug fixes",
				"other": "Other changes <!-- Non-user-facing changes go here. This section will not be copied to readme.txt. -->"
			}
		}
	}
}
