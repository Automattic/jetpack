{
	"name": "automattic/jetpack",
	"description": "Jetpack supercharges your self‑hosted WordPress site with the awesome cloud power of WordPress.com",
	"homepage": "https://jetpack.com/",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"support": {
		"issues": "https://github.com/Automattic/jetpack/issues"
	},
	"require": {
		"ext-fileinfo": "*",
		"ext-json": "*",
		"ext-openssl": "*",
		"automattic/block-delimiter": "^0.4.0",
		"automattic/jetpack-a8c-mc-stats": "^4.0.0",
		"automattic/jetpack-account-protection": "^0.4.0",
		"automattic/jetpack-activity-log": "^0.3.1",
		"automattic/jetpack-admin-ui": "^0.11.1",
		"automattic/jetpack-agents-manager": "^0.11.0",
		"automattic/jetpack-assets": "^5.0.1",
		"automattic/jetpack-autoloader": "^6.0.0",
		"automattic/jetpack-backup": "^5.0.0",
		"automattic/jetpack-blaze": "^0.29.0",
		"automattic/jetpack-blocks": "^4.0.0",
		"automattic/jetpack-boost-speed-score": "^0.5.0",
		"automattic/jetpack-classic-theme-helper": "^0.15.0",
		"automattic/jetpack-comments": "^0.1.1",
		"automattic/jetpack-compat": "^5.0.0",
		"automattic/jetpack-composer-plugin": "^5.0.0",
		"automattic/jetpack-config": "^4.0.0",
		"automattic/jetpack-connection": "^9.1.0",
		"automattic/jetpack-constants": "^4.0.0",
		"automattic/jetpack-device-detection": "^4.0.0",
		"automattic/jetpack-error": "^4.0.0",
		"automattic/jetpack-external-connections": "^0.2.0",
		"automattic/jetpack-external-media": "^0.9.0",
		"automattic/jetpack-feature-flags": "^0.2.0",
		"automattic/jetpack-forms": "^8.0.0",
		"automattic/jetpack-image-cdn": "^0.8.0",
		"automattic/jetpack-import": "^0.10.0",
		"automattic/jetpack-ip": "^0.6.0",
		"automattic/jetpack-jitm": "^5.0.1",
		"automattic/jetpack-licensing": "^4.0.0",
		"automattic/jetpack-logo": "^4.0.0",
		"automattic/jetpack-masterbar": "^0.28.0",
		"automattic/jetpack-menu-badges": "^0.2.0",
		"automattic/jetpack-my-jetpack": "^6.1.0",
		"automattic/jetpack-newsletter": "^0.13.0",
		"automattic/jetpack-paypal-payments": "^0.8.0",
		"automattic/jetpack-plugins-installer": "^0.6.0",
		"automattic/jetpack-podcast": "^2.0.0",
		"automattic/jetpack-post-list": "^0.10.0",
		"automattic/jetpack-post-media": "^0.2.0",
		"automattic/jetpack-premium-analytics": "^0.5.0",
		"automattic/jetpack-publicize": "^0.86.0",
		"automattic/jetpack-redirect": "^4.0.0",
		"automattic/jetpack-roles": "^4.0.0",
		"automattic/jetpack-scan-page": "^0.2.0",
		"automattic/jetpack-search": "^8.0.0",
		"automattic/jetpack-seo": "^0.9.0",
		"automattic/jetpack-stats": "^0.21.0",
		"automattic/jetpack-stats-admin": "^0.35.0",
		"automattic/jetpack-status": "^7.0.0",
		"automattic/jetpack-sync": "^5.0.1",
		"automattic/jetpack-videopress": "^0.49.0",
		"automattic/jetpack-waf": "^0.29.0",
		"automattic/jetpack-wp-abilities": "^0.2.0",
		"automattic/woocommerce-analytics": "^0.17"
	},
	"require-dev": {
		"antecedent/patchwork": "^2.2",
		"automattic/patchwork-redefine-exit": "^3.0.0",
		"automattic/phpunit-select-config": "^1.0.11",
		"yoast/phpunit-polyfills": "^4.0.0"
	},
	"scripts": {
		"build-production": [
			"pnpm run build-production-concurrently"
		],
		"build-development": [
			"pnpm run build-concurrently"
		],
		"phpunit": [
			"tests/action-phpunit.sh"
		],
		"test-js": "pnpm concurrently 'pnpm:test-adminpage' 'pnpm:test-extensions'",
		"test-js-coverage": "tests/action-test-js-coverage.sh",
		"test-php": [
			"@php tools/build-module-headings-translations.php",
			"tests/action-test-php.sh"
		],
		"test-php-coverage": [
			"@php tools/build-module-headings-translations.php",
			"tests/action-test-php-coverage.sh"
		],
		"watch": [
			"Composer\\Config::disableProcessTimeout",
			"pnpm run watch"
		]
	},
	"repositories": [],
	"autoload": {
		"classmap": [
			"src"
		]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"sort-packages": true,
		"platform": {
			"ext-intl": "0.0.0"
		},
		"autoloader-suffix": "f11009ded9fc4592b6a05b61ce272b3c_jetpackⓥ16_2_a_5",
		"allow-plugins": {
			"automattic/jetpack-autoloader": true,
			"automattic/jetpack-composer-plugin": true
		}
	},
	"extra": {
		"mirror-repo": "Automattic/jetpack-production",
		"release-branch-prefix": [
			"jetpack",
			"weekly",
			"monthly"
		],
		"version-constants": {
			"JETPACK__VERSION": "jetpack.php"
		},
		"wp-plugin-slug": "jetpack",
		"dev-releases": true,
		"changelogger-default-type": "other",
		"changelogger": {
			"versioning": "wordpress",
			"types": {
				"major": "Major Enhancements",
				"enhancement": "Enhancements",
				"compat": "Improved compatibility",
				"bugfix": "Bug fixes",
				"other": "Other changes <!-- Non-user-facing changes go here. This section will not be copied to readme.txt. -->"
			}
		}
	}
}
