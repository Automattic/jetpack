{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jetpack/latex",
	"version": "0.1.0",
	"title": "LaTex",
	"category": "formatting",
	"description": "Create and display LaTex with live preview and easy editing.",
	"example": {
		"attributes": {
			"latex": "\\frac{a}{b}"
		}
	},
	"attributes": {
		"latex": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "jetpack"
}
