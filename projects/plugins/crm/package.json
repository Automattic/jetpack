{
	"private": true,
	"name": "@automattic/jetpack-crm",
	"version": "6.7.2",
	"description": "The CRM for WordPress",
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack.git",
		"directory": "projects/plugins/crm"
	},
	"license": "GPL-2.0",
	"author": "Automattic",
	"scripts": {
		"build": "pnpm run clean && pnpm run build-client",
		"build-client": "webpack",
		"build-production": "NODE_ENV=production BABEL_ENV=production pnpm run build",
		"clean": "rm -rf build css/*.map.css css/*.min.css* css/*.min.rtl.css css/*.rtl.css css/welcome-to-zbs/*.min.css* css/welcome-to-zbs/*.min.rtl.css js/*.min.js* js/welcome-to-zbs/wizard2.min.js*",
		"watch": "pnpm run build && webpack watch"
	},
	"dependencies": {
		"@wordpress/theme": "0.11.0",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@automattic/color-studio": "4.1.0",
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@automattic/remove-asset-webpack-plugin": "workspace:*",
		"@babel/core": "7.29.0",
		"@babel/preset-env": "7.29.2",
		"@babel/runtime": "7.29.2",
		"@fullcalendar/core": "6.1.20",
		"chart.js": "4.5.0",
		"copy-webpack-plugin": "14.0.0",
		"css-loader": "6.11.0",
		"daterangepicker": "3.1.0",
		"font-awesome": "4.7.0",
		"fullcalendar": "6.1.20",
		"glob": "13.0.6",
		"hopscotch": "0.3.1",
		"jquery-modal": "0.9.2",
		"js-cookie": "3.0.5",
		"moment": "2.30.1",
		"push.js": "1.0.12",
		"sass-embedded": "1.97.3",
		"sass-loader": "16.0.5",
		"semantic-ui-css": "2.5.0",
		"sweetalert2": "7.33.1",
		"typeahead.js": "0.11.1",
		"webpack": "5.105.2",
		"webpack-cli": "6.0.1"
	}
}
