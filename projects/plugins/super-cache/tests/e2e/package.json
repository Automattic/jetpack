{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm jetpack build plugins/super-cache -v --no-pnpm-install --production",
		"clean": "rm -rf output",
		"distclean": "rm -rf node_modules",
		"env:down": "docker-compose down",
		"env:up": "docker-compose up -d",
		"pretest:run": "pnpm run clean",
