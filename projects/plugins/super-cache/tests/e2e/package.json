		"typecheck": "tsgo --noEmit"
	},
	"devDependencies": {
		"@jest/globals": "^30.0.0",
		"@types/node": "^24.12.0",
		"@types/shell-escape": "0.2.3",
		"@typescript/native-preview": "7.0.0-dev.20260225.1",
		"_jetpack-e2e-commons": "workspace:*",
		"axios": "1.13.5",
		"cheerio": "1.2.0",
		"domhandler": "5.0.3",
		"dotenv": "16.6.1",
		"jest": "^30.0.0",
		"jest-util": "^30.0.0",
		"shell-escape": "0.2.0",
		"ts-jest": "29.4.6",
		"typescript": "5.9.3"
	}
