#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/bash" ]; then
  exec "$basedir/bash"  "$basedir/../_jetpack-e2e-commons/bin/tunnel.sh" "$@"
else
  exec bash  "$basedir/../_jetpack-e2e-commons/bin/tunnel.sh" "$@"
fi
