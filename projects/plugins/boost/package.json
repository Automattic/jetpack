{
	"private": true,
	"description": "Boost your WordPress site's performance, from the creators of Jetpack",
	"homepage": "https://jetpack.com/boost/",
	"bugs": {
		"url": "https://github.com/Automattic/jetpack/labels/[Plugin] Boost"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Automattic/jetpack",
		"directory": "projects/plugins/boost"
	},
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"directories": {
		"test": "tests"
	},
	"scripts": {
		"build": "pnpm run clean && concurrently 'pnpm:build-client' 'pnpm:build:wp-build' && pnpm run build:stamp-textdomains && pnpm run build:boot-asset",
		"build:boot-asset": "provide-boot-asset-file",
		"build:stamp-textdomains": "stamp-textdomains --domain jetpack-boost",
		"build:strip-unminified-prod": "strip-unminified-prod",
		"build:wp-build": "wp-build",
		"build-client": "webpack",
		"build-concurrently": "pnpm run build",
		"build-production-concurrently": "pnpm run clean && concurrently 'NODE_ENV=production BABEL_ENV=production pnpm run build-client' 'pnpm:build:wp-build' && pnpm run build:stamp-textdomains && pnpm run build:strip-unminified-prod && pnpm run build:boot-asset && pnpm run validate",
		"clean": "rm -rf app/assets/dist/ build/",
		"test": "jest --config=tests/jest.config.cjs",
		"test-coverage": "pnpm run test --coverage",
		"test-e2e:decrypt-config": "pnpm --prefix tests/e2e run config:decrypt",
		"test-e2e:run": "pnpm --prefix tests/e2e run test:run",
		"test-e2e:start": "pnpm --prefix tests/e2e run tunnel:up && pnpm --prefix tests/e2e run env:up",
		"test-e2e:stop": "pnpm --prefix tests/e2e run tunnel:down && pnpm --prefix tests/e2e run env:down",
		"typecheck": "tsgo --noEmit --project tsconfig.dashboard.json",
		"validate": "pnpm exec validate-es app/assets/dist build/",
		"watch": "pnpm run build && concurrently 'pnpm:build-client --watch' 'pnpm:watch:wp-build'",
		"watch:wp-build": "wp-build --watch"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"dependencies": {
		"@automattic/charts": "workspace:*",
		"@automattic/jetpack-api": "workspace:*",
		"@automattic/jetpack-base-styles": "workspace:*",
		"@automattic/jetpack-my-jetpack": "workspace:*",
		"@automattic/jetpack-react-data-sync-client": "workspace:*",
		"@automattic/number-formatters": "workspace:*",
		"@jetpack-boost/init": "link:packages/init",
		"@react-spring/web": "10.1.1",
		"@tanstack/react-query": "5.101.2",
		"@types/react": "18.3.31",
		"@wordpress/admin-ui": "2.9.0",
		"@wordpress/api-fetch": "7.55.0",
		"@wordpress/base-styles": "13.1.0",
		"@wordpress/components": "40.1.0",
		"@wordpress/date": "5.55.0",
		"@wordpress/element": "8.7.0",
		"@wordpress/icons": "15.5.0",
		"@wordpress/route": "0.20.0",
		"@wordpress/ui": "0.21.0",
		"@wordpress/url": "4.55.0",
		"clsx": "2.1.1",
		"copy-webpack-plugin": "14.0.0",
		"react-router": "7.18.2",
		"react-use-measure": "2.1.1",
		"use-debounce": "10.0.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@automattic/jetpack-analytics": "workspace:*",
		"@automattic/jetpack-boost-score-api": "workspace:*",
		"@automattic/jetpack-components": "workspace:*",
		"@automattic/jetpack-critical-css-gen": "workspace:*",
		"@automattic/jetpack-image-guide": "workspace:*",
		"@automattic/jetpack-webpack-config": "workspace:*",
		"@automattic/jetpack-wp-build-polyfills": "workspace:*",
		"@babel/core": "7.29.7",
		"@storybook/react": "10.4.6",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/jest": "30.0.0",
		"@types/jquery": "3.5.34",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@wordpress/browserslist-config": "6.55.0",
		"@wordpress/build": "0.22.0",
		"@wordpress/i18n": "6.28.0",
		"@wordpress/theme": "2.0.0",
		"autoprefixer": "10.4.20",
		"browserslist": "^4.24.0",
		"concurrently": "10.0.5",
		"jest": "30.4.2",
		"livereload": "0.10.3",
		"path-browserify": "1.0.1",
		"postcss": "8.5.23",
		"postcss-loader": "8.2.0",
		"process": "0.11.10",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"sass-embedded": "1.97.3",
		"sass-loader": "16.0.5",
		"storybook": "10.4.6",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"webpack": "5.107.2",
		"webpack-cli": "7.2.1"
	},
	"wpPlugin": {
		"name": "jetpack_boost",
		"scriptGlobal": "jetpackBoost",
		"packageNamespace": "jetpack-boost",
		"handlePrefix": "jetpack-boost",
		"pages": [
			{
				"id": "jetpack-boost-dashboard",
				"init": [
					"@jetpack-boost/init"
				]
			}
		]
	}
}
