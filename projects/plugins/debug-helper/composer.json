{
	"name": "automattic/jetpack-debug-helper",
	"description": "A plugin for mocking various states of the plugin to aid in Jetpack development. Not for production use.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {},
	"require-dev": {
		"yoast/phpunit-polyfills": "^4.0.0",
		"automattic/phpunit-select-config": "@dev",
		"automattic/jetpack-wp-build-polyfills": "@dev"
	},
	"scripts": {
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-php": [
			"@composer phpunit"
		],
		"test-php-coverage": [
			"php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\""
		]
	},
	"repositories": [
		{
			"type": "path",
			"url": "../../packages/*",
			"options": {
				"monorepo": true
			}
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autotagger": {
			"v": false
		},
		"autorelease": true,
		"mirror-repo": "Automattic/jetpack-debug-helper",
		"version-constants": {
			"JETPACK_DEBUG_HELPER_VERSION": "plugin.php"
		},
		"release-branch-prefix": "debug-helper",
		"beta-plugin-slug": "jetpack-debug-helper",
		"changelogger": {
			"link-template": "https://github.com/Automattic/jetpack-debug-helper/compare/v${old}...v${new}"
		}
	}
}
