{
	"name": "automattic/action-agent-experience-eval",
	"description": "An action to evaluate a repository's AI agent experience quality",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"require": {},
	"require-dev": {
		"yoast/phpunit-polyfills": "^4.0.0",
		"automattic/jetpack-changelogger": "@dev",
		"automattic/phpunit-select-config": "@dev"
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"scripts": {
		"build-development": "echo 'Add your build step to composer.json, please!'",
		"build-production": "echo 'Add your build step to composer.json, please!'",
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-coverage": [
			"php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\""
		],
		"test-php": [
			"@composer phpunit"
		]
	},
	"repositories": [
		{
			"type": "path",
			"url": "../../packages/*",
			"options": {
				"monorepo": true
			}
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autotagger": {
			"major": true
		},
		"changelogger": {
			"link-template": "https://github.com/Automattic/action-agent-experience-eval/compare/v${old}...v${new}"
		},
		"mirror-repo": "Automattic/action-agent-experience-eval"
	}
}
