{
	"name": "automattic/action-agent-experience-eval",
	"description": "GitHub Action to evaluate a repository's AI agent experience quality.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require": {},
	"require-dev": {
		"automattic/jetpack-changelogger": "@dev"
	},
	"repositories": [
		{
			"type": "path",
			"url": "../../packages/*",
			"options": {
				"monorepo": true
			}
		}
	],
	"extra": {
		"autotagger": {
			"major": true
		},
		"autorelease": true,
		"mirror-repo": "Automattic/action-agent-experience-eval",
		"changelogger": {
			"link-template": "https://github.com/Automattic/action-agent-experience-eval/compare/v${old}...v${new}"
		}
	}
}
