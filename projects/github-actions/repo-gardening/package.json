{
	"private": true,
	"description": "Manage Pull Requests and issues in your Open Source project (automate labelling, milestones, feedback to PR authors, ...)",
	"keywords": [
		"wordpress",
		"automattic",
		"jetpack",
		"github",
		"action"
	],
	"license": "GPL-2.0-or-later",
	"author": "Automattic",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "ncc build src/index.ts -o dist --source-map --license licenses.txt -t",
		"test": "NODE_OPTIONS=--experimental-vm-modules jest --config=tests/jest.config.cjs --verbose",
		"test-coverage": "pnpm run test --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@actions/core": "2.0.2",
		"@actions/github": "7.0.0",
		"@slack/web-api": "7.12.0",
		"compare-versions": "6.1.1",
		"glob": "13.0.0",
		"moment": "2.30.1",
		"openai": "5.3.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/preset-typescript": "7.27.1",
		"@octokit/webhooks-types": "7.6.1",
		"@types/node": "^20.4.2",
		"@vercel/ncc": "0.36.1",
		"babel-jest": "30.2.0",
		"jest": "30.2.0",
		"typescript": "5.9.3"
	}
}
